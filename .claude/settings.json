{
  "permissions": {
    "allow": ["Skill", "Bash(cloudflare-inspect:*)", "Bash(gcloud-inspect:*)"],
    "ask": [
      "Bash(cloudflare-inspect --reviewed:*)",
      "Bash(gcloud-inspect --reviewed:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/credentials.json)",
      "Read(**/credentials.*.json)",
      "Read(**/secret.json)",
      "Read(**/secrets.json)",
      "Read(**/service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(**/.env*)",
      "Edit(~/.ssh/**)",
      "Bash(rm ~:*)",
      "Bash(rm /:*)",
      "Bash(rm -r ~:*)",
      "Bash(rm -r /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(nc:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(cf:*)",
      "Bash(command cf:*)",
      "Bash(env cf:*)",
      "Bash(/bin/cf:*)",
      "Bash(/usr/bin/cf:*)",
      "Bash(cloudflare:*)",
      "Bash(command cloudflare:*)",
      "Bash(env cloudflare:*)",
      "Bash(/bin/cloudflare:*)",
      "Bash(/usr/bin/cloudflare:*)",
      "Bash(gcloud:*)",
      "Bash(command gcloud:*)",
      "Bash(env gcloud:*)",
      "Bash(/bin/gcloud:*)",
      "Bash(/usr/bin/gcloud:*)",
      "Bash(aws:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(npm publish:*)",
      "Bash(mix hex.publish:*)"
    ]
  }
}
