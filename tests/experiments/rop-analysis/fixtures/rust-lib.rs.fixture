mod parser;
use parser::{parse as decode, ParseFault};

#[derive(Debug)]
pub enum Failure { Missing, Parse(ParseFault), Backup, Audit }
impl From<ParseFault> for Failure {
    fn from(value: ParseFault) -> Self { Self::Parse(value) }
}
type Attempt<T> = Result<T, Failure>;

struct Label<'a>(&'a str);
impl<'a> Label<'a> {
    fn or_else(self, _f: impl FnOnce() -> &'a str) -> Self { self }
}
fn first(input: &[&str]) -> Option<String> {
    let value = input.first()?;
    Some(value.trim().to_string())
}
fn backup(available: bool) -> Attempt<u32> {
    if available { Ok(7) } else { Err(Failure::Backup) }
}
fn audit(value: u32) -> Attempt<u32> {
    if value == 9 { Err(Failure::Audit) } else { Ok(value) }
}
pub fn checkout(input: &[&str], available: bool) -> Attempt<u32> {
    let attempt = || -> Attempt<u32> {
        let raw = first(input).ok_or(Failure::Missing)?;
        let label = Label(&raw).or_else(|| "0");
        let value = decode(label.0)?;
        Ok(value)
    };
    let value = attempt().or_else(|error| match error {
        Failure::Missing => backup(available),
        other => Err(other),
    })?;
    audit(value)
}
