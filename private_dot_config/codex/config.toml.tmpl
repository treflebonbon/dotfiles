model = "gpt-6.2-sol"
model_reasoning_effort = "xhigh"
model_reasoning_summary = "concise"
model_verbosity = "medium"
personality = "pragmatic"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
default_permissions = "dotfiles"

{{ $pluginPin := mustFromJson (include "private_dot_config/nix-devshell/skills-plugin.json") -}}
{{ $pluginSource := printf "%s/.cache/treflebonbon-skills/marketplaces/%s" .chezmoi.homeDir $pluginPin.rev -}}
{{ $pluginCheckout := printf "%s/.cache/treflebonbon-skills/checkouts/%s" .chezmoi.homeDir $pluginPin.rev -}}
{{ $xdgStateHome := env "XDG_STATE_HOME" -}}
{{ if and $xdgStateHome (not (hasPrefix "/" $xdgStateHome)) -}}
{{ fail "XDG_STATE_HOME must be absolute" }}
{{- end -}}
{{ $stateHome := or $xdgStateHome (printf "%s/.local/state" .chezmoi.homeDir) -}}
{{ $pluginReceipt := printf "%s/treflebonbon-skills/plugin-sync/receipt.json" $stateHome -}}
{{ $legacyCliRevision := (mustFromJson (include ".chezmoitemplates/local-skills-legacy.json")).revision -}}
{{ $legacyCliBackup := printf "%s/treflebonbon-skills/legacy/%s" $stateHome $legacyCliRevision -}}
[marketplaces.treflebonbon]
source_type = "local"
source = {{ printf "%q" $pluginSource }}

[agents]
default_subagent_model = "gpt-6-luna"
default_subagent_reasoning_effort = "xhigh"
max_concurrent_threads_per_session = 3

[apps.github]
default_tools_approval_mode = "approve"
destructive_enabled = false

[features]
# Nix Codex lacks the complete package required to install its daemon.
daemon_auto_start = false
hooks = true
goals = true
network_proxy = true

[mcp_servers.context7]
command = "bunx"
args = ["-y", "@upstash/context7-mcp"]

[mcp_servers.serena]
command = "uvx"
args = [
  "--from",
  "git+https://github.com/oraios/serena",
  "serena",
  "start-mcp-server",
  "--enable-web-dashboard",
  "false",
]

[permissions."dotfiles"]
extends = ":workspace"

[permissions."dotfiles".filesystem]
glob_scan_max_depth = 6
":slash_tmp" = "deny"
"~/.ssh" = "deny"
"~/.aws" = "deny"
"~/.config/gcloud" = "deny"
"~/.config/gh/hosts.yml" = "deny"
"~/.kube" = "deny"
"~/.docker/config.json" = "deny"
"~/.git-credentials" = "deny"
"~/.gnupg" = "deny"
"~/.codex/auth.json" = "deny"
"~/.codex-app/auth.json" = "deny"

[permissions."dotfiles".network]
enabled = false

[permissions."dotfiles-secure"]
extends = ":workspace"

[permissions."dotfiles-secure".filesystem]
glob_scan_max_depth = 16
":root" = "deny"
":minimal" = "read"
":slash_tmp" = "deny"
"/nix" = "read"
"~/.gitconfig" = "read"
"~/runtime/ai-runtimes.md" = "read"
"~/runtime/human-validation.md" = "read"
"~/runtime/index.md" = "read"
"~/runtime/investigation.md" = "read"
"~/runtime/shell-environment.md" = "read"
"~/runtime/skill-harness.md" = "read"
"~/.cache/nix-devshell-global-env.bash.codex" = "read"
"~/.config/nix-devshell/skills-plugin.json" = "read"
{{ printf "%q" $pluginReceipt }} = "read"
{{ printf "%q" $pluginCheckout }} = "read"
{{ printf "%q" $pluginSource }} = "read"
{{ printf "%q" $legacyCliBackup }} = "read"

{{ $secretRoots := dict "dotfiles" (list ":workspace_roots" "~/ghq/github.com" "~/orca/workspaces" "/tmp/codex") "dotfiles-secure" (list ":workspace_roots" "~/.local/bin" "~/.config/git" "~/.config/gh" "/tmp/codex") }}
{{ range $profile, $roots := $secretRoots }}
{{ range $root := $roots }}
[permissions."{{ $profile }}".filesystem."{{ $root }}"]
{{ if or (eq $root "/tmp/codex") (and (eq $profile "dotfiles-secure") (eq $root ":workspace_roots")) }}
"." = "write"
{{ else if eq $profile "dotfiles-secure" }}
"." = "read"
{{ end }}
{{ if and (eq $profile "dotfiles-secure") (ne $root "/tmp/codex") }}
".env" = "deny"
"*/**/.env" = "deny"
{{ else }}
{{/* 存在しない .env に mount target を作らないため glob にする。 */}}
"**/.env" = "deny"
{{ end }}
"**/.env[!.r]*" = "deny"
"**/.envr" = "deny"
"**/.envr[!c]*" = "deny"
"**/.envrc?*" = "deny"
"**/.env." = "deny"
"**/.env.[!e]*" = "deny"
"**/.env.e" = "deny"
"**/.env.e[!x]*" = "deny"
"**/.env.ex" = "deny"
"**/.env.ex[!a]*" = "deny"
"**/.env.exa" = "deny"
"**/.env.exa[!m]*" = "deny"
"**/.env.exam" = "deny"
"**/.env.exam[!p]*" = "deny"
"**/.env.examp" = "deny"
"**/.env.examp[!l]*" = "deny"
"**/.env.exampl" = "deny"
"**/.env.exampl[!e]*" = "deny"
"**/.env.example?*" = "deny"
"**/*.pem" = "deny"
"**/*.key" = "deny"
"**/*.pfx" = "deny"
"**/*.p12" = "deny"
"**/credentials.json" = "deny"
"**/credentials.*.json" = "deny"
"**/secret.json" = "deny"
"**/secrets.json" = "deny"
"**/service-account*.json" = "deny"
{{ end }}
{{ end }}

[permissions."dotfiles-secure".network]
enabled = true

[permissions."dotfiles-secure".network.domains]
"registry.npmjs.org" = "allow"
"**.github.com" = "allow"
"**.githubusercontent.com" = "allow"
"**.context7.com" = "allow"
"**.pypi.org" = "allow"
"files.pythonhosted.org" = "allow"
"**.python.org" = "allow"
"cache.nixos.org" = "allow"
"nodejs.org" = "allow"
"proxy.golang.org" = "allow"
"sum.golang.org" = "allow"
"**.crates.io" = "allow"
"static.rust-lang.org" = "allow"
"**.hex.pm" = "allow"
"cpan.metacpan.org" = "allow"


[plugins."github@openai-curated"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."ponytail@ponytail"]
enabled = true

[plugins."treflebonbon-skills@treflebonbon"]
enabled = true
