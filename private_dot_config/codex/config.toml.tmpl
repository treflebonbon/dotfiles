model = "gpt-6.1-sol"
model_reasoning_effort = "xhigh"
model_reasoning_summary = "concise"
model_verbosity = "medium"
personality = "pragmatic"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
default_permissions = "dotfiles-secure"

[agents]
default_subagent_model = "gpt-6-luna"
default_subagent_reasoning_effort = "xhigh"
max_concurrent_threads_per_session = 3

[apps.github]
default_tools_approval_mode = "approve"
destructive_enabled = false

[features]
# Nix Codex lacks the complete package required to install its daemon.
daemon_auto_start = false
hooks = true
goals = true
network_proxy = true

[mcp_servers.context7]
command = "bunx"
args = ["-y", "@upstash/context7-mcp"]

[mcp_servers.serena]
command = "uvx"
args = [
  "--from",
  "git+https://github.com/oraios/serena",
  "serena",
  "start-mcp-server",
  "--enable-web-dashboard",
  "false",
]

{{/* dotfiles-peer is dotfiles-secure for an auto codex peer: ~/.config/gh (the writable gh credential) is not readable; only the peer's own read-only gh config dir is. */ -}}
{{ range $profile := list (dict "name" "dotfiles-secure" "ghRoot" "~/.config/gh") (dict "name" "dotfiles-peer" "ghRoot" "~/.codex-peer/gh") -}}
[permissions."{{ $profile.name }}"]
extends = ":workspace"

[permissions."{{ $profile.name }}".filesystem]
glob_scan_max_depth = 4
":root" = "deny"
":minimal" = "read"
":slash_tmp" = "deny"
"/nix" = "read"
"~/.gitconfig" = "read"

{{ range $root := list ":workspace_roots" "~/.local/bin" "~/.config/git" $profile.ghRoot "/tmp/codex" }}
[permissions."{{ $profile.name }}".filesystem."{{ $root }}"]
"." = "{{ if or (eq $root ":workspace_roots") (eq $root "/tmp/codex") }}write{{ else }}read{{ end }}"
{{ if eq $root "/tmp/codex" }}
{{/* 存在しない共有領域の .env に mount target を作らないため glob にする。 */}}
"**/.env" = "deny"
{{ else }}
".env" = "deny"
"*/**/.env" = "deny"
{{ end }}
"**/.env[!.r]*" = "deny"
"**/.envr" = "deny"
"**/.envr[!c]*" = "deny"
"**/.envrc?*" = "deny"
"**/.env." = "deny"
"**/.env.[!e]*" = "deny"
"**/.env.e" = "deny"
"**/.env.e[!x]*" = "deny"
"**/.env.ex" = "deny"
"**/.env.ex[!a]*" = "deny"
"**/.env.exa" = "deny"
"**/.env.exa[!m]*" = "deny"
"**/.env.exam" = "deny"
"**/.env.exam[!p]*" = "deny"
"**/.env.examp" = "deny"
"**/.env.examp[!l]*" = "deny"
"**/.env.exampl" = "deny"
"**/.env.exampl[!e]*" = "deny"
"**/.env.example?*" = "deny"
"**/*.pem" = "deny"
"**/*.key" = "deny"
"**/*.pfx" = "deny"
"**/*.p12" = "deny"
"**/credentials.json" = "deny"
"**/credentials.*.json" = "deny"
"**/secret.json" = "deny"
"**/secrets.json" = "deny"
"**/service-account*.json" = "deny"
{{ end }}

[permissions."{{ $profile.name }}".network]
enabled = true

[permissions."{{ $profile.name }}".network.domains]
"registry.npmjs.org" = "allow"
"**.github.com" = "allow"
"**.githubusercontent.com" = "allow"
"**.context7.com" = "allow"
"**.pypi.org" = "allow"
"files.pythonhosted.org" = "allow"
"**.python.org" = "allow"
"cache.nixos.org" = "allow"
"proxy.golang.org" = "allow"
"sum.golang.org" = "allow"
"**.crates.io" = "allow"
"static.rust-lang.org" = "allow"
"**.hex.pm" = "allow"
"cpan.metacpan.org" = "allow"

{{ end -}}

[plugins."github@openai-curated"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."ponytail@ponytail"]
enabled = true
