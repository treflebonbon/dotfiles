# Block privilege escalation and direct access to privileged cloud CLIs.
prefix_rule(
    pattern = [["sudo", "su"]],
    decision = "forbidden",
    justification = "Privilege escalation must be reviewed outside Codex automation.",
    match = [
        "sudo apt update",
        "su root",
    ],
    not_match = [
        "systemctl status ssh",
    ],
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "Avoid world-writable permissions; use the minimum required mode instead.",
    match = [
        "chmod 777 /tmp/example",
    ],
    not_match = [
        "chmod 755 scripts/tool.sh",
    ],
)

prefix_rule(
    pattern = [["nc", "gcloud", "aws"]],
    decision = "forbidden",
    justification = "Network probes and cloud CLIs can affect shared infrastructure; request explicit user direction first.",
    match = [
        "nc -zv example.com 443",
        "gcloud projects list",
        "aws s3 ls",
    ],
    not_match = [
        "gh pr view 1",
    ],
)

# Block destructive infrastructure and publishing commands.
prefix_rule(
    pattern = ["terraform", ["apply", "destroy"]],
    decision = "forbidden",
    justification = "Terraform mutations affect shared infrastructure and must be run manually.",
    match = [
        "terraform apply",
        "terraform destroy -auto-approve",
    ],
    not_match = [
        "terraform plan",
    ],
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "forbidden",
    justification = "Deleting Kubernetes resources affects shared infrastructure; inspect resources first.",
    match = [
        "kubectl delete pod example",
    ],
    not_match = [
        "kubectl get pods",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Repository deletion is destructive and must be performed manually.",
    match = [
        "gh repo delete owner/repo",
    ],
    not_match = [
        "gh repo view owner/repo",
    ],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "forbidden",
    justification = "Package publishing is visible to others and must be performed manually.",
    match = [
        "npm publish",
    ],
    not_match = [
        "npm pack",
    ],
)

prefix_rule(
    pattern = ["mix", "hex.publish"],
    decision = "forbidden",
    justification = "Package publishing is visible to others and must be performed manually.",
    match = [
        "mix hex.publish",
    ],
    not_match = [
        "mix test",
    ],
)

# Block raw push syntax so force refspecs cannot bypass prefix matching.
prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Use git-push-topic for preauthorized topic branches or git-push-reviewed for an approval-gated non-force push.",
    match = [
        "git push origin HEAD",
        "git push origin main",
        "git push origin +HEAD",
        "git push -u --force origin HEAD",
    ],
)

# `prefix_rule` matches argv exactly, so also block common ways to move `push`
# away from argv[1]. Use a shell `cd` followed by plain `git` for other work.
prefix_rule(
    pattern = [["/bin/git", "/usr/bin/git"], "push"],
    decision = "forbidden",
    justification = "Use git-push-topic or git-push-reviewed instead of an absolute git path.",
    match = [
        "/bin/git push origin HEAD",
        "/usr/bin/git push origin HEAD --force",
    ],
)

prefix_rule(
    pattern = ["git", ["-C", "-c", "--git-dir", "--work-tree"]],
    decision = "forbidden",
    justification = "Global git options can hide a push from approval rules; use a shell cd and plain git instead.",
    match = [
        "git -C . push origin HEAD",
        "git -c core.hooksPath=/dev/null push origin HEAD",
        "git --git-dir .git push origin HEAD",
        "git --work-tree . push origin HEAD",
    ],
)

prefix_rule(
    pattern = [["command", "env"], "git"],
    decision = "forbidden",
    justification = "Shell wrappers can hide a push from approval rules; invoke plain git or a managed push wrapper.",
    match = [
        "command git push origin HEAD",
        "env git push origin HEAD --force",
    ],
)

prefix_rule(
    pattern = ["git-push-topic"],
    decision = "allow",
    justification = "The wrapper accepts no arguments and publishes only the validated current topic branch.",
    match = [
        "git-push-topic",
    ],
)

prefix_rule(
    pattern = ["git-push-reviewed"],
    decision = "prompt",
    justification = "The wrapper fixes the push to origin HEAD, but default-branch publication still requires approval.",
    match = [
        "git-push-reviewed",
    ],
)

prefix_rule(
    pattern = ["gh-review-thread", ["inspect", "reply-resolve"]],
    decision = "allow",
    justification = "Review Round の thread-aware read と検証済み reply/resolve は専用 CLI に限定して実行する。",
    match = [
        "gh-review-thread inspect --repo owner/repo --pr 42",
        "gh-review-thread reply-resolve --repo owner/repo --pr 42 --thread-id PRRT_1 --body-file reply.md",
    ],
)

# Block direct deletion of root or home, and require approval for recursive deletes.
prefix_rule(
    pattern = ["rm", ["/", "~"]],
    decision = "forbidden",
    justification = "Deleting root or home is catastrophic; inspect the target instead.",
    match = [
        "rm /",
        "rm ~",
    ],
    not_match = [
        "rm ./file",
    ],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "-rf", "-fr"], ["/", "~"]],
    decision = "forbidden",
    justification = "Recursive deletion of root or home is catastrophic; inspect the target instead.",
    match = [
        "rm -r /",
        "rm -rf ~",
        "rm -fr /",
    ],
    not_match = [
        "rm -rf ./tmp",
    ],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "-rf", "-fr"], "--", ["/", "~"]],
    decision = "forbidden",
    justification = "Recursive deletion of root or home is catastrophic; inspect the target instead.",
    match = [
        "rm -rf -- /",
        "rm -r -- ~",
    ],
    not_match = [
        "rm -rf -- ./tmp",
    ],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "-rf", "-fr"]],
    decision = "prompt",
    justification = "Recursive deletes require explicit approval.",
    match = [
        "rm -rf ./tmp",
        "rm -r build",
    ],
    not_match = [
        "rm ./file",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", ["view", "list", "create", "edit", "comment"]],
    decision = "allow",
    justification = "内容確定後の定型 issue 操作は二重確認せず実行する。",
    match = ["gh issue create --title t", "gh issue edit 904 --add-label ready-for-agent", "gh issue view 904"],
)

prefix_rule(
    pattern = ["gh", "issue", ["close", "reopen", "delete"]],
    decision = "prompt",
    justification = "Issue state transitions and deletion remain user-reviewed.",
    match = ["gh issue close 904", "gh issue reopen 904", "gh issue delete 904"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "comment", "review", "ready"]],
    decision = "allow",
    justification = "内容確定後の定型 PR 公開操作は二重確認せず実行する。",
    match = [
        "gh pr create --title t --body b",
        "gh pr edit 904 --title t",
        "gh pr review 904 --approve",
        "gh pr ready 904",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["close", "reopen", "merge"]],
    decision = "prompt",
    justification = "PR state transitions and merge remain user-reviewed.",
    match = ["gh pr close 904", "gh pr reopen 904", "gh pr merge 904"],
)

prefix_rule(
    pattern = ["gh", "search", "issues"],
    decision = "allow",
    justification = "dedup preflight (dogfood-to-issues / design-to-issues)。",
    match = ["gh search issues query"],
)

prefix_rule(
    pattern = ["gh", "label", ["list", "create", "edit"]],
    decision = "allow",
    justification = "label の参照・作成・編集は定型の repo setup 操作。",
    match = ["gh label list", "gh label create test", "gh label edit test --color ffffff"],
)

prefix_rule(
    pattern = ["gh", "label", "delete"],
    decision = "prompt",
    justification = "Label deletion remains user-reviewed.",
    match = ["gh label delete test"],
)

prefix_rule(
    pattern = ["gh", "api", "rate_limit"],
    decision = "allow",
    justification = "preflight の network probe。",
    match = ["gh api rate_limit"],
)
