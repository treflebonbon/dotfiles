# .envrc - direnv configuration for flake devShell
if ! has nix; then
  echo "Nix is not installed. Please run install.sh first."
  exit 1
fi

if [ -n "${WSL_DISTRO_NAME:-}" ] || {
  [ -r /proc/sys/kernel/osrelease ] && grep -Eqi '(microsoft|wsl)' /proc/sys/kernel/osrelease;
}; then
  use flake .#wsl
else
  use flake
fi
