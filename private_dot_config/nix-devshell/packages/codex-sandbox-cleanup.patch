+// Keep the existing cleanup owner outside the caller's process group. A caller
+// killed with SIGKILL cannot clean up; parent death instead sends this supervisor
+// SIGTERM, which the existing bubblewrap signal forwarders handle before cleanup.
+fn supervise_bwrap_cleanup() -> ForwardedSignalMask {
+    let signal_mask = ForwardedSignalMask::block();
+    let parent_pid = unsafe { libc::getpid() };
+    let pid = unsafe { libc::fork() };
+    if pid < 0 {
+        panic!(
+            "failed to fork bubblewrap cleanup supervisor: {}",
+            std::io::Error::last_os_error()
+        );
+    }
+    if pid == 0 {
+        reset_forwarded_signal_handlers_to_default();
+        if unsafe { libc::setpgid(0, 0) } < 0 {
+            panic!(
+                "failed to isolate bubblewrap cleanup supervisor: {}",
+                std::io::Error::last_os_error()
+            );
+        }
+        terminate_with_parent(parent_pid);
+        // Keep forwarded signals blocked until the existing child setup installs
+        // its handlers. No synthetic mount target exists before that setup.
+        return signal_mask;
+    }
+    let signal_forwarders = install_bwrap_signal_forwarders(pid);
+    signal_mask.restore();
+    let status = wait_for_bwrap_child(pid);
+    signal_forwarders.restore();
+    exit_with_wait_status(status);
+}
