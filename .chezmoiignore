# （ADR-0020）のため、Linux/コンテナ（bash 前提、ADR-0001/0018）では配備しない。
{{- if ne .chezmoi.os "darwin" }}
.zshrc
{{- end }}

# Codex CLI plugin のランタイムファイル（chezmoi 管理外）
