#!/usr/bin/env python3
"""Repository trust and project devShell preparation for runtime adapters."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import select
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from urllib.parse import quote


class InvalidContext(Exception):
    pass


class PreparationError(Exception):
    pass


def executable(name):
    path = shutil.which(name)
    return str(Path(path).resolve(strict=True)) if path else None


def git_environment():
    return {
        key: value for key, value in os.environ.items() if not key.startswith("GIT_")
    }


def git_path(directory, option):
    result = subprocess.run(
        ["git", "-C", str(directory), "rev-parse", "--path-format=absolute", option],
        env=git_environment(),
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.rstrip("\n")).resolve(strict=True)


def metadata_target(path, prefix=""):
    if path.is_symlink():
        raise InvalidContext("symlinked Git metadata pointer")
    lines = path.read_text(encoding="utf-8").splitlines()
    if len(lines) != 1 or not lines[0].startswith(prefix):
        raise InvalidContext("invalid Git metadata pointer")
    target = lines[0][len(prefix) :].strip()
    if not target:
        raise InvalidContext("empty Git metadata pointer")
    return (path.parent / target).resolve(strict=True)


@dataclass(frozen=True)
class Repository:
    root: Path
    git_dir: Path
    common_dir: Path

    @classmethod
    def discover(cls, directory, linked_only=False):
        try:
            root = git_path(directory, "--show-toplevel")
            git_dir = git_path(root, "--git-dir")
            common = git_path(root, "--git-common-dir")
            pointer = root / ".git"
            if pointer.is_symlink():
                raise InvalidContext("symlinked worktree metadata")
            if git_dir == common:
                if linked_only or not pointer.is_dir() or pointer.resolve() != common:
                    raise InvalidContext(
                        "current directory is not a linked Git worktree"
                    )
            elif not (
                metadata_target(pointer, "gitdir:") == git_dir
                and metadata_target(git_dir / "commondir") == common
                and git_dir.parent == common / "worktrees"
                and metadata_target(git_dir / "gitdir") == pointer
            ):
                raise InvalidContext(
                    "linked worktree metadata ownership does not match"
                )
            return cls(root, git_dir, common)
        except (
            OSError,
            ValueError,
            RuntimeError,
            subprocess.CalledProcessError,
        ) as error:
            raise InvalidContext("cannot resolve Git worktree metadata") from error

    def identity(self):
        stat = self.common_dir.stat()
        return {
            "common_dir": str(self.common_dir),
            "device": stat.st_dev,
            "inode": stat.st_ino,
        }


def trust_file(repo):
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    directory = (state / "devshell-env/trust").resolve()
    ancestor = directory
    while not ancestor.exists():
        ancestor = ancestor.parent
    result = subprocess.run(
        ["git", "-C", str(ancestor), "rev-parse", "--git-dir"],
        env=git_environment(),
        capture_output=True,
    )
    if result.returncode == 0 or directory.is_relative_to(repo.common_dir):
        raise InvalidContext(
            "trust state must be outside repositories and Git metadata"
        )
    digest = hashlib.sha256(os.fsencode(repo.common_dir)).hexdigest()
    return directory / (digest + ".json")


def trusted(repo):
    path = trust_file(repo)
    if path.is_symlink():
        raise InvalidContext("symlinked trust record")
    try:
        return json.loads(path.read_text()) == repo.identity()
    except FileNotFoundError:
        return False


def trust_command(command, repo):
    path = trust_file(repo)
    if command == "trust":
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with tempfile.NamedTemporaryFile(
            mode="w", dir=path.parent, delete=False
        ) as output:
            json.dump(repo.identity(), output)
        os.replace(output.name, path)
    elif command == "untrust":
        path.unlink(missing_ok=True)
    state = "trusted" if trusted(repo) else "untrusted"
    flake = "flake present" if (repo.root / "flake.nix").is_file() else "no flake"
    print(f"devshell-env: {state}; {flake}; {repo.root}")


def selected_output(repo):
    explicit = os.environ.get("DEVSHELL_ENV_OUTPUT")
    if explicit:
        if not all(
            part and all(c.isalnum() or c in "_-" for c in part)
            for part in explicit.split(".")
        ):
            raise PreparationError(
                "DEVSHELL_ENV_OUTPUT must name an output in the current flake"
            )
        return explicit
    release = Path("/proc/sys/kernel/osrelease")
    wsl = bool(os.environ.get("WSL_DISTRO_NAME")) or (
        release.is_file()
        and any(word in release.read_text().lower() for word in ("microsoft", "wsl"))
    )
    return "wsl" if wsl and (repo.root / ".wsl-browser-free").is_file() else "default"


def prepared_context(repo):
    files = {}
    for name in ("flake.nix", "flake.lock"):
        path = repo.root / name
        files[name] = (
            hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None
        )
    return json.dumps(
        {
            "root": str(repo.root),
            "repository": repo.identity(),
            "output": selected_output(repo),
            "files": files,
        },
        sort_keys=True,
    )


def prepare_environment(repo, inherited, require_trust=True):
    if require_trust and not trusted(repo):
        raise PreparationError("untrusted repository; run devshell-env trust")
    if not (repo.root / "flake.nix").is_file():
        raise PreparationError("no flake.nix at the worktree root")
    output = selected_output(repo)
    context = prepared_context(repo)
    nix = executable("nix")
    bash = executable("bash")
    if not nix or not bash:
        raise PreparationError("nix and bash are required")
    # Do not feed inherited secrets or direnv's Nix selection into persisted Nix output.
    bootstrap = {
        key: inherited[key]
        for key in (
            "HOME",
            "USER",
            "LOGNAME",
            "PATH",
            "XDG_CACHE_HOME",
            "NIX_REMOTE",
            "NIX_SSL_CERT_FILE",
            "SSL_CERT_FILE",
        )
        if key in inherited
    }
    bootstrap["TMPDIR"] = "/tmp"
    result = subprocess.run(
        [
            nix,
            "--extra-experimental-features",
            "nix-command flakes",
            "print-dev-env",
            "--no-write-lock-file",
            f"git+file://{quote(str(repo.root), safe='/')}#{output}",
        ],
        cwd=repo.root,
        env=bootstrap,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise PreparationError(
            f"Nix preparation failed ({result.returncode}): {result.stderr.strip()}"
        )
    # Shell code and its environment travel through pipes, never a project environment cache.
    script = """
set -e
eval "$(cat)" >&2
exec "$1" -I -c 'import json,os; print(json.dumps(dict(os.environ)))'
"""
    result = subprocess.run(
        [bash, "--noprofile", "--norc", "-c", script, "devshell-env", sys.executable],
        input=result.stdout,
        cwd=repo.root,
        env=bootstrap,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise PreparationError(
            f"shellHook preparation failed ({result.returncode}): {result.stderr.strip()}"
        )
    prepared = json.loads(result.stdout)
    if not isinstance(prepared, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in prepared.items()
    ):
        raise PreparationError("invalid devShell environment output")
    environment = inherited.copy()
    for key, value in prepared.items():
        if key in {
            "HOME",
            "USER",
            "LOGNAME",
            "PWD",
            "OLDPWD",
            "TMPDIR",
            "SHLVL",
            "_",
            "SHELL",
            "BASH_ENV",
            "ENV",
            "XDG_CONFIG_HOME",
            "XDG_CACHE_HOME",
            "XDG_DATA_HOME",
            "XDG_STATE_HOME",
            "XDG_RUNTIME_DIR",
        }:
            continue
        if key.startswith(("GIT_", "CODEX_", "DEVSHELL_ENV_")):
            continue
        if bootstrap.get(key) != value:
            environment[key] = value
    paths = (prepared.get("PATH", "") + os.pathsep + inherited.get("PATH", "")).split(
        os.pathsep
    )
    environment["PATH"] = os.pathsep.join(dict.fromkeys(path for path in paths if path))
    if prepared_context(repo) != context:
        raise PreparationError("flake changed during preparation; restart the session")
    environment["DEVSHELL_ENV_CONTEXT"] = context
    print(f"devshell-env: ready; {repo.root}#{output}", file=sys.stderr)
    return environment


def dotenv_environment(repo, prepared, inherited):
    from dotenv.parser import parse_stream
    from dotenv.variables import parse_variables

    path = repo.root / ".env"
    try:
        path.lstat()
    except FileNotFoundError:
        return prepared
    try:
        target = path.resolve(strict=True)
        if not target.is_relative_to(repo.root):
            raise PreparationError("root .env must stay inside the current worktree")
        if target == repo.root:
            raise PreparationError("root .env must be a regular file")
        # Open each resolved component without following a replacement symlink.
        directory = os.open(repo.root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            parts = target.relative_to(repo.root).parts
            for part in parts[:-1]:
                child = os.open(
                    part,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=directory,
                )
                os.close(directory)
                directory = child
            descriptor = os.open(
                parts[-1],
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=directory,
            )
        finally:
            os.close(directory)
        with os.fdopen(descriptor, encoding="utf-8") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise PreparationError("root .env must be a regular file")
            bindings = list(parse_stream(stream))
    except (OSError, UnicodeError, RuntimeError) as error:
        raise PreparationError("cannot read root .env") from error
    environment = prepared.copy()
    expansion = prepared | inherited
    for binding in bindings:
        if binding.error:
            raise PreparationError(f"invalid root .env at line {binding.original.line}")
        key, value = binding.key, binding.value
        if key is None or value is None:
            continue
        if not key or "=" in key or "\0" in key or "\0" in value:
            raise PreparationError(f"invalid root .env at line {binding.original.line}")
        value = "".join(atom.resolve(expansion) for atom in parse_variables(value))
        environment[key] = inherited.get(key, prepared.get(key, value))
        expansion[key] = environment[key]
    return environment


def launch_with_env(arguments):
    reuse_prepared = arguments[:1] == ["--prepared"]
    if reuse_prepared:
        arguments = arguments[1:]
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    if not arguments:
        raise PreparationError(
            "usage: devshell-env with-env [--prepared] -- command [args...]"
        )
    inherited = git_environment()
    repo = Repository.discover(Path.cwd())
    identity = repo.identity()
    if reuse_prepared:
        context = inherited.get("DEVSHELL_ENV_CONTEXT")
        if not context:
            raise PreparationError(
                "no prepared devShell; restart through codex-worktree"
            )
        if context != prepared_context(repo):
            raise PreparationError(
                "prepared devShell belongs to another root or flake; restart the session"
            )
        prepared = inherited
    else:
        # The normal public entry always prepares, regardless of ambient metadata.
        inherited.pop("DEVSHELL_ENV_CONTEXT", None)
        prepared = prepare_environment(repo, inherited, require_trust=False)
        prepared.pop("DEVSHELL_ENV_CONTEXT", None)
    if Repository.discover(repo.root) != repo or repo.identity() != identity:
        raise InvalidContext("worktree metadata changed during preparation")
    environment = dotenv_environment(repo, prepared, inherited)
    os.execvpe(arguments[0], arguments, environment)


def validate_codex_arguments(arguments):
    expect_profile = False
    prohibited_long = {
        "--cd",
        "--config",
        "--enable",
        "--disable",
        "--sandbox",
        "--add-dir",
        "--profile",
        "--approve-for-me",
        "--dangerously-bypass-approvals-and-sandbox",
        "--yolo",
        "--ignore-user-config",
        "--ignore-rules",
        "--dangerously-bypass-hook-trust",
        "--remote",
        "--remote-auth-token-env",
        "--sandbox-state-json",
        "--sandbox-state-readable-root",
    }
    for argument in arguments:
        if expect_profile:
            if argument != "dotfiles-secure":
                raise InvalidContext("permission profile must remain dotfiles-secure")
            expect_profile = False
        elif argument == "--":
            break
        elif argument in ("-P", "--permission-profile", "--permissions-profile"):
            expect_profile = True
        elif argument.startswith(
            ("-P", "--permission-profile=", "--permissions-profile=")
        ):
            profile = (
                argument[2:] if argument.startswith("-P") else argument.split("=", 1)[1]
            )
            if profile != "dotfiles-secure":
                raise InvalidContext("permission profile must remain dotfiles-secure")
        elif (
            argument == "features"
            or argument.split("=", 1)[0] in prohibited_long
            or argument.startswith(("-C", "-c", "-s", "-p"))
        ):
            raise InvalidContext(
                f"argument can replace the worktree runtime boundary: {argument}"
            )
    if expect_profile:
        raise InvalidContext("missing permission profile value")


def codex_workspace_roots(codex, repo, environment):
    """Read Codex's effective config, including its own config-layer resolution."""
    with subprocess.Popen(
        [codex, "app-server"],
        cwd=repo.root,
        env=environment,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=0,
    ) as process:
        pending = b""

        def request(identifier, method, params):
            nonlocal pending
            message = {"id": identifier, "method": method, "params": params}
            process.stdin.write((json.dumps(message) + "\n").encode())
            deadline = time.monotonic() + 20
            while True:
                if b"\n" not in pending:
                    remaining = max(0, deadline - time.monotonic())
                    if not select.select([process.stdout], [], [], remaining)[0]:
                        raise InvalidContext("Codex config/read timed out")
                    chunk = os.read(process.stdout.fileno(), 65536)
                    if not chunk:
                        raise InvalidContext("Codex config/read closed unexpectedly")
                    pending += chunk
                    continue
                line, pending = pending.split(b"\n", 1)
                response = json.loads(line)
                if response.get("id") == identifier:
                    if "error" in response:
                        raise InvalidContext("Codex config/read failed")
                    return response["result"]

        try:
            request(
                1,
                "initialize",
                {"clientInfo": {"name": "devshell-env", "version": "1"}},
            )
            config = request(
                2, "config/read", {"includeLayers": False, "cwd": str(repo.root)}
            )["config"]
        except (KeyError, ValueError, TypeError) as error:
            raise InvalidContext("invalid Codex config/read response") from error
        finally:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()

    profiles = config.get("permissions") or {}
    name = "dotfiles-secure"
    roots = set()
    visited = set()
    while not name.startswith(":"):
        if name in visited or name not in profiles:
            raise InvalidContext("cannot resolve dotfiles-secure inheritance")
        visited.add(name)
        profile = profiles[name]
        roots.update((profile.get("workspace_roots") or {}).keys())
        name = profile.get("extends") or ":workspace"
    return roots


def launch_codex(arguments):
    validate_codex_arguments(arguments)
    inherited = git_environment()
    inherited.pop("CODEX_PERMISSION_PROFILE", None)
    inherited.pop("DEVSHELL_ENV_CONTEXT", None)
    inherited["TMPDIR"] = "/tmp"
    repo = Repository.discover(Path.cwd(), linked_only=True)
    identity = repo.identity()
    codex = executable("codex")
    if not codex:
        raise InvalidContext("codex is not available on the launcher's PATH")
    try:
        environment = prepare_environment(repo, inherited)
    except (PreparationError, InvalidContext, OSError, ValueError) as error:
        print(
            f"devshell-env: {error}; starting Codex without project environment",
            file=sys.stderr,
        )
        environment = inherited
    permission_arguments = []
    dotenv_rule = ""
    dotenv = repo.root / ".env"
    try:
        regular_dotenv = stat.S_ISREG(dotenv.lstat().st_mode)
    except FileNotFoundError:
        regular_dotenv = False
    if "DEVSHELL_ENV_CONTEXT" in environment and regular_dotenv:
        roots = codex_workspace_roots(codex, repo, inherited)
        # Profile-defined roots must not receive this session's root dotenv grant.
        disabled = ",".join(f"{json.dumps(root)}=false" for root in sorted(roots))
        permission_arguments = [
            "-c",
            "permissions.dotfiles-secure.workspace_roots={" + disabled + "}",
        ]
        dotenv_rule = ',":workspace_roots"={".env"="read"}'
    # A shellHook can change cwd/environment or metadata; enforce the original boundary afterwards.
    if (
        Repository.discover(repo.root, linked_only=True) != repo
        or repo.identity() != identity
    ):
        raise InvalidContext("worktree metadata changed during preparation")
    boundary = ",".join(
        f'{json.dumps(str(path), ensure_ascii=False)}="write"'
        for path in (repo.git_dir, repo.common_dir)
    )
    # Only this private temporary directory is writable; /tmp itself stays denied.
    environment["TMPDIR"] = tempfile.mkdtemp(prefix="codex-worktree-", dir="/tmp")
    os.chdir(repo.root)
    os.execve(
        codex,
        [
            codex,
            "-C",
            str(repo.root),
            "-c",
            'default_permissions="dotfiles-secure"',
            "-c",
            "permissions.dotfiles-secure.filesystem={" + boundary + dotenv_rule + "}",
            *permission_arguments,
            *arguments,
        ],
        environment,
    )


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "with-env":
        try:
            launch_with_env(sys.argv[2:])
        except (PreparationError, InvalidContext, OSError, ValueError) as error:
            print(f"with-env: {error}", file=sys.stderr)
            return 1
    if len(sys.argv) > 1 and sys.argv[1] == "codex":
        try:
            launch_codex(sys.argv[2:])
        except (InvalidContext, OSError) as error:
            print(f"codex-worktree: {error}", file=sys.stderr)
            return 1
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["trust", "untrust", "status"])
    parser.add_argument("directory", nargs="?", default=".")
    args = parser.parse_args()
    try:
        trust_command(args.command, Repository.discover(args.directory))
    except (InvalidContext, OSError, ValueError) as error:
        print(f"devshell-env: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
