#!/usr/bin/env python3
"""Repository trust and project devShell preparation for runtime adapters."""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import runpy
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import uuid
from dataclasses import dataclass
from urllib.parse import quote


class InvalidContext(Exception):
    pass


class PreparationError(Exception):
    pass


def executable(name):
    path = shutil.which(name)
    return str(Path(path).resolve(strict=True)) if path else None


def git_environment():
    return {
        key: value for key, value in os.environ.items() if not key.startswith("GIT_")
    }


def git_path(directory, option):
    result = subprocess.run(
        ["git", "-C", str(directory), "rev-parse", "--path-format=absolute", option],
        env=git_environment(),
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.rstrip("\n")).resolve(strict=True)


def metadata_target(path, prefix=""):
    if path.is_symlink():
        raise InvalidContext("symlinked Git metadata pointer")
    lines = path.read_text(encoding="utf-8").splitlines()
    if len(lines) != 1 or not lines[0].startswith(prefix):
        raise InvalidContext("invalid Git metadata pointer")
    target = lines[0][len(prefix) :].strip()
    if not target:
        raise InvalidContext("empty Git metadata pointer")
    return (path.parent / target).resolve(strict=True)


@dataclass(frozen=True)
class Repository:
    root: Path
    git_dir: Path
    common_dir: Path

    @classmethod
    def discover(cls, directory, linked_only=False, *, allow_gitfile=False):
        try:
            root = git_path(directory, "--show-toplevel")
            git_dir = git_path(root, "--git-dir")
            common = git_path(root, "--git-common-dir")
            pointer = root / ".git"
            if pointer.is_symlink():
                raise InvalidContext("symlinked worktree metadata")
            if git_dir == common:
                # Unlinked gitfiles have no ownership backlink; only explicit
                # commands may accept them, never automatic trust or raw launch.
                if linked_only or not (
                    (pointer.is_dir() and pointer.resolve() == common)
                    or (
                        allow_gitfile
                        and pointer.is_file()
                        and metadata_target(pointer, "gitdir:") == git_dir
                    )
                ):
                    raise InvalidContext(
                        "current directory is not a linked Git worktree"
                    )
            elif not (
                metadata_target(pointer, "gitdir:") == git_dir
                and metadata_target(git_dir / "commondir") == common
                and git_dir.parent == common / "worktrees"
                and metadata_target(git_dir / "gitdir") == pointer
            ):
                raise InvalidContext(
                    "linked worktree metadata ownership does not match"
                )
            return cls(root, git_dir, common)
        except (
            OSError,
            ValueError,
            RuntimeError,
            subprocess.CalledProcessError,
        ) as error:
            raise InvalidContext("cannot resolve Git worktree metadata") from error

    def identity(self):
        stat = self.common_dir.stat()
        return {
            "common_dir": str(self.common_dir),
            "device": stat.st_dev,
            "inode": stat.st_ino,
        }


def trust_file(repo):
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    directory = (state / "devshell-env/trust").resolve()
    ancestor = directory
    while not ancestor.exists():
        ancestor = ancestor.parent
    result = subprocess.run(
        ["git", "-C", str(ancestor), "rev-parse", "--git-dir"],
        env=git_environment(),
        capture_output=True,
    )
    if result.returncode == 0 or directory.is_relative_to(repo.common_dir):
        raise InvalidContext(
            "trust state must be outside repositories and Git metadata"
        )
    digest = hashlib.sha256(os.fsencode(repo.common_dir)).hexdigest()
    return directory / (digest + ".json")


def trusted(repo):
    path = trust_file(repo)
    if path.is_symlink():
        raise InvalidContext("symlinked trust record")
    try:
        return json.loads(path.read_text()) == repo.identity()
    except FileNotFoundError:
        return False


def trust_command(command, repo):
    path = trust_file(repo)
    if command == "trust":
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with tempfile.NamedTemporaryFile(
            mode="w", dir=path.parent, delete=False
        ) as output:
            json.dump(repo.identity(), output)
        os.replace(output.name, path)
    elif command == "untrust":
        path.unlink(missing_ok=True)
    state = "trusted" if trusted(repo) else "untrusted"
    flake = "flake present" if (repo.root / "flake.nix").is_file() else "no flake"
    print(f"devshell-env: {state}; {flake}; {repo.root}")


def selected_output(repo):
    explicit = os.environ.get("DEVSHELL_ENV_OUTPUT")
    if explicit:
        if not all(
            part and all(c.isalnum() or c in "_-" for c in part)
            for part in explicit.split(".")
        ):
            raise PreparationError(
                "DEVSHELL_ENV_OUTPUT must name an output in the current flake"
            )
        return explicit
    release = Path("/proc/sys/kernel/osrelease")
    wsl = bool(os.environ.get("WSL_DISTRO_NAME")) or (
        release.is_file()
        and any(word in release.read_text().lower() for word in ("microsoft", "wsl"))
    )
    return "wsl" if wsl and (repo.root / ".wsl-browser-free").is_file() else "default"


def prepared_context(repo):
    files = {}
    for name in ("flake.nix", "flake.lock"):
        path = repo.root / name
        files[name] = (
            hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None
        )
    return json.dumps(
        {
            "root": str(repo.root),
            "repository": repo.identity(),
            "output": selected_output(repo),
            "files": files,
        },
        sort_keys=True,
    )


def prepare_environment(
    repo, inherited, require_trust=True, timeout=None, *, isolated=False
):
    if require_trust and not trusted(repo):
        raise PreparationError("untrusted repository; run devshell-env trust")
    if not (repo.root / "flake.nix").is_file():
        raise PreparationError("no flake.nix at the worktree root")
    output = selected_output(repo)
    context = prepared_context(repo)
    nix = executable("nix")
    bash = executable("bash")
    if not nix or not bash:
        raise PreparationError("nix and bash are required")
    # Do not feed inherited secrets or direnv's Nix selection into persisted Nix output.
    bootstrap = {
        key: inherited[key]
        for key in (
            "HOME",
            "USER",
            "LOGNAME",
            "PATH",
            "XDG_CACHE_HOME",
            "NIX_REMOTE",
            "NIX_SSL_CERT_FILE",
            "SSL_CERT_FILE",
        )
        if key in inherited
    }
    bootstrap["TMPDIR"] = "/tmp"
    if isolated:
        # These values were created by the outer launcher after isolation.
        # Human/Claude preparation keeps its existing bootstrap contract.
        for key in (
            "NIX_CONFIG",
            "HTTP_PROXY",
            "HTTPS_PROXY",
            "http_proxy",
            "https_proxy",
            "NO_PROXY",
            "no_proxy",
        ):
            if key in inherited:
                bootstrap[key] = inherited[key]
    result = subprocess.run(
        [
            nix,
            "--extra-experimental-features",
            "nix-command flakes",
            "print-dev-env",
            "--no-write-lock-file",
            f"git+file://{quote(str(repo.root), safe='/')}#{output}",
        ],
        cwd=repo.root,
        env=bootstrap,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    if result.returncode:
        raise PreparationError(
            f"Nix preparation failed ({result.returncode}): {result.stderr.strip()}"
        )
    # Shell code and its environment travel through pipes, never a project environment cache.
    script = """
set -e
eval "$(cat)" >&2
exec "$1" -I -c 'import json,os; print(json.dumps(dict(os.environ)))'
"""
    result = subprocess.run(
        [bash, "--noprofile", "--norc", "-c", script, "devshell-env", sys.executable],
        input=result.stdout,
        cwd=repo.root,
        env=bootstrap,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    if result.returncode:
        raise PreparationError(
            f"shellHook preparation failed ({result.returncode}): {result.stderr.strip()}"
        )
    prepared = json.loads(result.stdout)
    if not isinstance(prepared, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in prepared.items()
    ):
        raise PreparationError("invalid devShell environment output")
    environment = inherited.copy()
    for key, value in prepared.items():
        if key in {
            "HOME",
            "USER",
            "LOGNAME",
            "PWD",
            "OLDPWD",
            "TMPDIR",
            "SHLVL",
            "_",
            "SHELL",
            "BASH_ENV",
            "ENV",
            "XDG_CONFIG_HOME",
            "XDG_CACHE_HOME",
            "XDG_DATA_HOME",
            "XDG_STATE_HOME",
            "XDG_RUNTIME_DIR",
        }:
            continue
        if key.startswith(("GIT_", "CODEX_", "DEVSHELL_ENV_")):
            continue
        if bootstrap.get(key) != value:
            environment[key] = value
    paths = (prepared.get("PATH", "") + os.pathsep + inherited.get("PATH", "")).split(
        os.pathsep
    )
    environment["PATH"] = os.pathsep.join(dict.fromkeys(path for path in paths if path))
    if prepared_context(repo) != context:
        raise PreparationError("flake changed during preparation; restart the session")
    environment["DEVSHELL_ENV_CONTEXT"] = context
    print(f"devshell-env: ready; {repo.root}#{output}", file=sys.stderr)
    return environment


def dotenv_environment(repo, prepared, inherited):
    path = repo.root / ".env"
    try:
        path.lstat()
    except FileNotFoundError:
        return prepared
    from dotenv.parser import parse_stream
    from dotenv.variables import parse_variables

    try:
        target = path.resolve(strict=True)
        if not target.is_relative_to(repo.root):
            raise PreparationError("root .env must stay inside the current worktree")
        if target == repo.root:
            raise PreparationError("root .env must be a regular file")
        # Open each resolved component without following a replacement symlink.
        directory = os.open(repo.root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            parts = target.relative_to(repo.root).parts
            for part in parts[:-1]:
                child = os.open(
                    part,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=directory,
                )
                os.close(directory)
                directory = child
            descriptor = os.open(
                parts[-1],
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=directory,
            )
        finally:
            os.close(directory)
        with os.fdopen(descriptor, encoding="utf-8") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise PreparationError("root .env must be a regular file")
            bindings = list(parse_stream(stream))
    except (OSError, UnicodeError, RuntimeError) as error:
        raise PreparationError("cannot read root .env") from error
    environment = prepared.copy()
    expansion = prepared | inherited
    for binding in bindings:
        if binding.error:
            raise PreparationError(f"invalid root .env at line {binding.original.line}")
        key, value = binding.key, binding.value
        if key is None or value is None:
            continue
        if not key or "=" in key or "\0" in key or "\0" in value:
            raise PreparationError(f"invalid root .env at line {binding.original.line}")
        value = "".join(atom.resolve(expansion) for atom in parse_variables(value))
        environment[key] = inherited.get(key, prepared.get(key, value))
        expansion[key] = environment[key]
    return environment


def launch_with_env(arguments):
    reuse_prepared = arguments[:1] == ["--prepared"]
    if reuse_prepared:
        arguments = arguments[1:]
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    if not arguments:
        raise PreparationError(
            "usage: devshell-env with-env [--prepared] -- command [args...]"
        )
    inherited = os.environ.copy()
    repo = Repository.discover(Path.cwd(), allow_gitfile=True)
    identity = repo.identity()
    if reuse_prepared:
        context = inherited.get("DEVSHELL_ENV_CONTEXT")
        if not context:
            raise PreparationError(
                "no prepared devShell; restart through codex-worktree"
            )
        if context != prepared_context(repo):
            raise PreparationError(
                "prepared devShell belongs to another root or flake; restart the session"
            )
        prepared = inherited
    else:
        # The normal public entry always prepares, regardless of ambient metadata.
        inherited.pop("DEVSHELL_ENV_CONTEXT", None)
        prepared = prepare_environment(repo, inherited, require_trust=False)
        prepared.pop("DEVSHELL_ENV_CONTEXT", None)
    if (
        Repository.discover(repo.root, allow_gitfile=True) != repo
        or repo.identity() != identity
    ):
        raise InvalidContext("worktree metadata changed during preparation")
    # This read-only copy is installed only inside the raw outer namespace.
    # Codex may materialize unreadable placeholders for denied paths such as .env.
    isolated = Path(__file__).resolve() == Path("/nix/codex-isolation/bin/devshell-env")
    environment = (
        prepared if isolated else dotenv_environment(repo, prepared, inherited)
    )
    os.execvpe(arguments[0], arguments, environment)


def validate_codex_arguments(arguments):
    expect_profile = False
    prohibited_long = {
        "--cd",
        "--config",
        "--enable",
        "--disable",
        "--sandbox",
        "--add-dir",
        "--profile",
        "--approve-for-me",
        "--dangerously-bypass-approvals-and-sandbox",
        "--yolo",
        "--ignore-user-config",
        "--ignore-rules",
        "--dangerously-bypass-hook-trust",
        "--remote",
        "--remote-auth-token-env",
        "--sandbox-state-json",
        "--sandbox-state-readable-root",
    }
    for argument in arguments:
        if expect_profile:
            if argument != "dotfiles-secure":
                raise InvalidContext("permission profile must remain dotfiles-secure")
            expect_profile = False
        elif argument == "--":
            break
        elif argument in ("-P", "--permission-profile", "--permissions-profile"):
            expect_profile = True
        elif argument.startswith(
            ("-P", "--permission-profile=", "--permissions-profile=")
        ):
            profile = (
                argument[2:] if argument.startswith("-P") else argument.split("=", 1)[1]
            )
            if profile != "dotfiles-secure":
                raise InvalidContext("permission profile must remain dotfiles-secure")
        elif (
            argument == "features"
            or argument.split("=", 1)[0] in prohibited_long
            or argument.startswith(("-C", "-c", "-s", "-p"))
        ):
            raise InvalidContext(
                f"argument can replace the worktree runtime boundary: {argument}"
            )
    if expect_profile:
        raise InvalidContext("missing permission profile value")


def claude_session(session_id):
    if not isinstance(session_id, str) or not session_id:
        raise InvalidContext("missing Claude session_id")
    digest = hashlib.sha256(session_id.encode()).hexdigest()
    return validate_claude_session(claude_state_root() / digest)


def claude_state_root():
    config = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude")))
    return config / "projects/.devshell-env"


def validate_claude_session(directory):
    if directory.parent != claude_state_root() or not re.fullmatch(
        r"[0-9a-f]{64}", directory.name
    ):
        raise InvalidContext("invalid Claude session state path")
    if directory.is_symlink() or directory.parent.is_symlink():
        raise InvalidContext("symlinked Claude session state")
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    if directory.stat().st_uid != os.getuid() or directory.stat().st_mode & 0o077:
        raise InvalidContext("Claude session state must be private to the current user")
    return directory


def write_session_file(path, content):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as output:
        output.write(content)
    os.replace(output.name, path)


def claude_environment(repo):
    # Only a small bootstrap reaches Nix. In particular, an inherited value that
    # shellHook copies under another name must never reach a session file.
    paths = list(
        dict.fromkeys(
            str(Path(path).parent)
            for name in ("nix", "bash", "git", "cat")
            if (path := executable(name))
        )
    )
    bootstrap = {"HOME": str(Path.home()), "PATH": os.pathsep.join(paths)}
    prepared = prepare_environment(repo, bootstrap, timeout=50)
    changes = {
        key: value
        for key, value in prepared.items()
        if bootstrap.get(key) != value
        and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key)
        and not key.startswith(
            ("CLAUDE_", "ANTHROPIC_", "DEVSHELL_ENV_", "BASH", "__devshell_")
        )
    }
    changes["PATH"] = os.pathsep.join(
        path
        for path in prepared["PATH"].split(os.pathsep)
        if path and path not in paths
    )
    return changes


def write_claude_environment(directory, changes):
    helper = Path(__file__).resolve().parent.parent / "share/devshell-env/claude-env.sh"
    lines = [
        f"source {shlex.quote(str(helper))}",
        f"__devshell_begin {shlex.quote(str(uuid.uuid4()))} || return 0",
        f"export DEVSHELL_ENV_SESSION={shlex.quote(str(directory))}",
    ]
    for key, value in changes.items():
        command = "__devshell_path" if key == "PATH" else f"__devshell_set {key}"
        lines.append(f"{command} {shlex.quote(value)}")
    write_session_file(directory / "env.sh", "\n".join(lines) + "\n")


def update_claude_environment(directory, cwd, force=False):
    repo = None
    reason = None
    try:
        repo = Repository.discover(cwd)
        target = {
            "root": str(repo.root),
            "identity": repo.identity(),
            "output": selected_output(repo),
            "trusted": trusted(repo),
            "flake": (repo.root / "flake.nix").is_file(),
        }
    except (InvalidContext, PreparationError, OSError, ValueError) as error:
        target = {"cwd": str(cwd)}
        reason = str(error)
    state = directory / "state.json"
    if not force and state.exists() and json.loads(state.read_text()) == target:
        return None
    # Clear before evaluation, including timeout/interruption. A partial or failed
    # preparation must never leave the previous project's overlay active.
    write_claude_environment(directory, {})
    write_session_file(state, json.dumps(target))
    if reason:
        raise PreparationError(reason)
    changes = claude_environment(repo)
    if Repository.discover(repo.root) != repo or repo.identity() != target["identity"]:
        raise InvalidContext("worktree metadata changed during preparation")
    write_claude_environment(directory, changes)
    return f"devshell-env: ready; {repo.root}#{target['output']}"


def claude_hook():
    payload = json.load(sys.stdin)
    event = payload.get("hook_event_name")
    if event not in ("SessionStart", "CwdChanged", "PreToolUse"):
        raise InvalidContext("unsupported Claude hook event")
    directory = claude_session(payload.get("session_id"))
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if not env_file and event != "PreToolUse":
        raise InvalidContext("Claude hook did not supply CLAUDE_ENV_FILE")
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        script = directory / "env.sh"
        if event == "PreToolUse" and not script.is_file():
            raise InvalidContext(
                "SessionStart has not connected the Claude environment"
            )
        if not script.exists():
            write_claude_environment(directory, {})
        source = f"\nsource {shlex.quote(str(script))}\n"
        if env_file:
            with open(env_file, "a+") as output:
                output.seek(0)
                if source not in output.read():
                    output.write(source)
        # CwdChanged is asynchronous and is absent on EnterWorktree in Claude
        # 2.1.263. Only synchronous events activate an overlay, using their actual
        # cwd, so a delayed CwdChanged can never overwrite a newer environment.
        if event == "CwdChanged":
            return 0
        message = update_claude_environment(
            directory, payload.get("cwd"), force=event == "SessionStart"
        )
    if message:
        print(json.dumps({"systemMessage": message}))
    return 0


def claude_reload():
    session = os.environ.get("DEVSHELL_ENV_SESSION")
    if not session or not (Path(session) / "state.json").is_file():
        raise InvalidContext("reload requires a managed Claude Bash session")
    directory = validate_claude_session(Path(session))
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        message = update_claude_environment(directory, Path.cwd(), force=True)
    print(f"{message}; applies to subsequent Bash commands")
    return 0


def isolation_module():
    path = (
        Path(__file__).resolve().parent.parent
        / "share/codex-isolation/secret-isolation-worktree.py"
    )
    return runpy.run_path(str(path))


def launch_codex(arguments):
    module = isolation_module()
    try:
        return module["launch"](arguments)
    except (
        module["DEVENV"]["InvalidContext"],
        module["DEVENV"]["PreparationError"],
    ) as error:
        raise InvalidContext(str(error)) from None


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "with-env":
        try:
            launch_with_env(sys.argv[2:])
        except (PreparationError, InvalidContext, OSError, ValueError) as error:
            print(f"with-env: {error}", file=sys.stderr)
            return 1
    if len(sys.argv) == 2 and sys.argv[1] == "reload":
        try:
            return claude_reload()
        except (
            PreparationError,
            InvalidContext,
            OSError,
            ValueError,
            subprocess.TimeoutExpired,
        ) as error:
            print(f"devshell-env: {error}; no project environment", file=sys.stderr)
            return 1
    if len(sys.argv) == 2 and sys.argv[1] == "claude-hook":
        try:
            return claude_hook()
        except (
            PreparationError,
            InvalidContext,
            OSError,
            ValueError,
            subprocess.TimeoutExpired,
        ) as error:
            print(
                json.dumps(
                    {"systemMessage": f"devshell-env: {error}; no project environment"}
                )
            )
            return 0
    if len(sys.argv) > 1 and sys.argv[1] == "codex":
        try:
            return launch_codex(sys.argv[2:])
        except (
            InvalidContext,
            PreparationError,
            OSError,
            ValueError,
            KeyError,
            subprocess.SubprocessError,
        ) as error:
            print(f"codex-worktree: {error}", file=sys.stderr)
            return 1
    if len(sys.argv) > 1 and sys.argv[1] == "admit":
        parser = argparse.ArgumentParser(
            description="Declare these files and reachable Git history public inputs for raw Codex."
        )
        parser.add_argument("--git-head", required=True)
        parser.add_argument(
            "--mcp", action="append", choices=("context7", "serena"), default=[]
        )
        parser.add_argument("--github-policy", type=Path)
        parser.add_argument("files", nargs="+")
        args = parser.parse_args(sys.argv[2:])
        try:
            module = isolation_module()
            try:
                repo = module["Repository"].discover(Path.cwd(), linked_only=True)
                module["admit"](
                    repo,
                    args.git_head,
                    args.files,
                    mcp=args.mcp,
                    github_policy=args.github_policy,
                )
            except module["DEVENV"]["InvalidContext"] as error:
                raise InvalidContext(str(error)) from None
            return 0
        except (
            OSError,
            ValueError,
            KeyError,
            InvalidContext,
            subprocess.SubprocessError,
        ) as error:
            print(f"devshell-env: {error}", file=sys.stderr)
            return 1
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="In a managed Claude Bash session, 'devshell-env reload' refreshes the next Bash command's environment.",
    )
    parser.add_argument("command", choices=["trust", "untrust", "status"])
    parser.add_argument("directory", nargs="?", default=".")
    args = parser.parse_args()
    try:
        trust_command(args.command, Repository.discover(args.directory))
    except (InvalidContext, OSError, ValueError) as error:
        print(f"devshell-env: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
