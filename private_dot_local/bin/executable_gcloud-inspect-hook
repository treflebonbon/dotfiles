#!/usr/bin/env -S python3 -I

"""PreToolUse hook: 単独の gcloud 呼出しを gcloud-inspect へ書換える。

Claude Code と Codex が共有する。書換えるのは「展開を伴わないリテラル引数だけの単独呼出し」のみ。
gcloud と認識できても安全に書換えられない入力は deny し、それ以外は何も出力しない（既存ルールに任せる）。
許可リストや機密項目の除外は gcloud-inspect の責務で、ここでは判定しない。docs/adr/0077 を参照。
"""

import json
import re
import shlex
import sys
from typing import NamedTuple

REASONS = {
    "compound": (
        "gcloud を含む複合 shell（cd・&&・パイプ・コマンド置換など）は自動で書換えられません。"
        "gcloud <引数> を単独で1回呼び出してください。後処理は結果を受け取ってから別の呼出しで行います。"
        "直接の gcloud や別の実行方法で迂回しないでください。"
    ),
    "unsupported": (
        "展開（$・バッククォート・glob・~・{}）、環境変数の代入、リダイレクト、改行・コメントを含む gcloud は"
        "自動で書換えられません。リテラルの引数だけで gcloud <引数> を単独で1回呼び出してください。"
        "直接の gcloud や別の実行方法で迂回しないでください。"
    ),
    "reviewed": (
        "先頭の --reviewed は自動変換しません。対象・コマンド・必要な理由をユーザーへ示して確認を得た後、"
        "gcloud-inspect --reviewed <引数> を明示的に実行してください。"
    ),
}

ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
# 直後の単語もコマンド位置として扱うシェル構文。
COMMAND_KEYWORDS = {"if", "then", "else", "elif", "do", "while", "until", "time", "!", "{"}
# 置換の中身で、先頭または演算子・予約語の直後にある gcloud。gcloud-inspect などは含めない。
NESTED_GCLOUD = re.compile(
    r"(?:\A|[;&|({`\n]|\$\(|\b(?:if|then|else|elif|do|while|until|time)\b|!\s)\s*gcloud(?![\w./-])"
)
OPERATORS = "\n;|&()"
WORD_END = " \t" + OPERATORS + "<>"


class Word(NamedTuple):
    value: str
    plain: bool  # 引用符・エスケープを使わない素の表記
    bad: bool  # 展開または未対応の構文を含む
    command_position: bool


class Scan:
    """command を単語へ分解し、構造（演算子・置換）と未対応構文の有無を集める。

    コメントと heredoc の本文は読み飛ばし、その後の行は走査を続ける。二重引用符内の置換にある heredoc だけは、
    本文の終わりを決められないため、そこで走査を止める。
    """

    def __init__(self, command):
        self.command = command.strip()
        self.structure = False  # 演算子・サブシェルを含む
        self.redirect = False  # リダイレクト・コメントを含む
        self.assignment = False  # 環境変数の代入をコマンドの前に置く
        self.nested_gcloud = False  # コマンド置換の先頭に gcloud がある
        self.words = []
        self.stopped = False
        self._run()

    def _substitution(self, i):
        """i が $( またはバッククォートなら、(置換の中身の開始位置, バッククォートか) を返す。"""
        if self.command.startswith("$(", i):
            return i + 2, False
        if self.command[i] == "`":
            return i + 1, True
        return None

    def _substitution_end(self, text):
        """$( の中身 text で、対応する閉じ括弧の位置を返す。なければ末尾。"""
        depth, i, n = 1, 0, len(text)
        while i < n:
            c = text[i]
            if c == "\\":
                i += 1
            elif c == "'":
                i = text.find("'", i + 1)
                if i < 0:
                    return n
            elif c == '"':
                i += 1
                while i < n and text[i] != '"':
                    i += 2 if text[i] == "\\" else 1
            elif c == "(":
                depth += 1
            elif c == ")":
                depth -= 1
                if depth == 0:
                    return i
            i += 1
        return n

    def _enter_substitution(self, content_start, backtick):
        # heredoc の本文と、置換が閉じた後の文字列は走査しない。
        content = self.command[content_start:].split("<<", 1)[0]
        content = content.split("`", 1)[0] if backtick else content[: self._substitution_end(content)]
        if NESTED_GCLOUD.search(content):
            self.nested_gcloud = True

    def _heredoc_delimiter(self, i):
        """<< の直後から終端語を読む。(次の位置, (終端語, タブを無視するか)) を返し、読めなければ None。"""
        command, n = self.command, len(self.command)
        strip_tabs = command.startswith("-", i)
        i += strip_tabs
        while i < n and command[i] in " \t":
            i += 1
        start = i
        while i < n and command[i] not in WORD_END:
            i += 1
        delimiter = re.sub(r"['\"\\]", "", command[start:i])
        return i, (delimiter, strip_tabs) if delimiter else None

    def _skip_heredocs(self, i, pending):
        """改行の直後から、各 heredoc の終端行までを読み飛ばす。"""
        command, n = self.command, len(self.command)
        for delimiter, strip_tabs in pending:
            while i < n:
                end = command.find("\n", i)
                end = n if end < 0 else end
                line = command[i:end]
                i = end + 1
                if (line.lstrip("\t") if strip_tabs else line) == delimiter:
                    break
        return min(i, n)

    def _run(self):
        command, n = self.command, len(self.command)
        at_start = True
        pending = []  # 本文を読み飛ばす heredoc
        i = 0
        while i < n and not self.stopped:
            ch = command[i]
            if ch in " \t":
                i += 1
            elif ch in OPERATORS:
                self.structure = True
                at_start = True
                i += 1
                if ch == "\n" and pending:
                    i = self._skip_heredocs(i, pending)
                    pending = []
            elif ch in "<>":
                self.redirect = True
                if command.startswith("<<", i) and not command.startswith("<<<", i):
                    i, heredoc = self._heredoc_delimiter(i + 2)
                    if heredoc is None:
                        self.stopped = True
                    else:
                        pending.append(heredoc)
                    continue
                i += 1
                while i < n and command[i] in "&>|<":
                    i += 1
            elif ch == "#":
                # 行コメント。次の改行まで読み飛ばし、以降の行は走査を続ける。
                self.redirect = True
                end = command.find("\n", i)
                i = n if end < 0 else end
            else:
                start = i
                i, word = self._word(i)
                if at_start and ASSIGNMENT.match(command, start):
                    self.assignment = True
                else:
                    self.words.append(word._replace(command_position=at_start))
                    at_start = word.plain and word.value in COMMAND_KEYWORDS

    def _word(self, i):
        command, n = self.command, len(self.command)
        value, plain, bad = "", True, False
        while i < n and command[i] not in WORD_END and not self.stopped:
            c = command[i]
            if c == "'":
                plain = False
                end = command.find("'", i + 1)
                if end < 0:
                    bad, i = True, n
                else:
                    value += command[i + 1 : end]
                    i = end + 1
            elif c == '"':
                plain = False
                i += 1
                in_substitution = False
                while True:
                    if i >= n:
                        bad = True
                        break
                    d = command[i]
                    if d == '"':
                        i += 1
                        break
                    if in_substitution and command.startswith("<<", i):
                        self.stopped = True
                        break
                    if d == "\\" and i + 1 < n and command[i + 1] in '$`"\\':
                        value += command[i + 1]
                        i += 2
                        continue
                    if d in "$`":
                        bad = True
                        content = self._substitution(i)
                        if content is not None:
                            in_substitution = True
                            self._enter_substitution(*content)
                    value += d
                    i += 1
            elif c == "\\":
                plain = False
                if i + 1 >= n or command[i + 1] == "\n":
                    bad = True
                    i += 1
                else:
                    value += command[i + 1]
                    i += 2
            elif c in "$`":
                bad = True
                content = self._substitution(i)
                if content is not None:
                    self._enter_substitution(*content)
                value += c
                i += 1
            else:
                if c in "*?[{~":
                    bad = True
                value += c
                i += 1
        if "\n" in value:
            bad = True
        return i, Word(value, plain, bad, False)


def classify(command):
    """('rewrite', args) | ('deny', 理由キー) | None を返す。None は何もしない。"""
    scan = Scan(command)
    gcloud_words = [w for w in scan.words if w.command_position and w.plain and w.value == "gcloud"]
    if not (gcloud_words or scan.nested_gcloud):
        return None
    # 先頭以外のコマンド位置にある gcloud（time gcloud など）も、単独の呼出しではない。
    if scan.structure or scan.nested_gcloud or gcloud_words[0] is not scan.words[0]:
        return ("deny", "compound")
    if scan.assignment or scan.redirect or any(w.bad for w in scan.words):
        return ("deny", "unsupported")
    args = [w.value for w in scan.words[1:]]
    if args and args[0] == "--reviewed":
        return ("deny", "reviewed")
    return ("rewrite", args)


def respond(**fields):
    json.dump({"hookSpecificOutput": {"hookEventName": "PreToolUse", **fields}}, sys.stdout, ensure_ascii=False)


def main():
    payload = json.load(sys.stdin)
    tool_input = payload["tool_input"]
    command = tool_input["command"]
    if payload.get("tool_name") != "Bash" or not isinstance(command, str):
        return
    decision = classify(command)
    if decision is None:
        return
    kind, detail = decision
    if kind == "deny":
        respond(permissionDecision="deny", permissionDecisionReason=REASONS[detail])
        return
    rewritten = " ".join(["gcloud-inspect", *map(shlex.quote, detail)])
    respond(permissionDecision="allow", updatedInput={**tool_input, "command": rewritten})


if __name__ == "__main__":
    try:
        main()
    except Exception:
        # hook の失敗で作業を止めない。既存の deny / forbidden ルールが元の command を扱う。
        pass
