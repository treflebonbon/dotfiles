#!/usr/bin/env -S python3 -I
"""Run the pinned raw Codex worktree entry without importing startup code."""

from pathlib import Path
import runpy
import sys

directory = Path(__file__).absolute().parent
installed = directory / "sync-skills-plugin"
source = directory / "executable_sync-skills-plugin"
helper = installed if installed.is_file() else source
if not helper.is_file():
    print(f"codex-worktree: missing sibling helper: {helper}", file=sys.stderr)
    sys.exit(127)
sys.argv = [str(helper), "--run-raw", "codex-worktree", "--", *sys.argv[1:]]
runpy.run_path(str(helper), run_name="__main__")
