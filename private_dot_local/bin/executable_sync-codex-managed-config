#!/usr/bin/env bash
set -euo pipefail

verify_only=0
if [ "$#" -gt 0 ]; then
  if [ "$#" -eq 1 ] && [ "$1" = "--verify-only" ]; then
    verify_only=1
  else
    echo "Usage: sync-codex-managed-config [--verify-only]" >&2
    exit 2
  fi
fi

managed_root="$HOME/.config/codex"
managed_config="$managed_root/config.toml"
managed_files=(config.toml hooks.json rules/default.rules environments/environment.toml AGENTS.md)
codex_homes=("$HOME/.codex")
staged_files=()
targets=()
phase="prepare"
target="$managed_root"
verified_plugin_state=""

cleanup() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    printf 'ERROR: Codex managed sync %s failed: %s\n' "$phase" "$target" >&2
  fi
  local staged
  for staged in "${staged_files[@]+"${staged_files[@]}"}"; do
    rm -f -- "$staged"
  done
  return "$status"
}
trap cleanup EXIT

for relative_path in "${managed_files[@]}"; do
  target="$managed_root/$relative_path"
  if [ ! -f "$target" ]; then
    echo "ERROR: Codex managed source not found: $target" >&2
    exit 1
  fi
done

append_codex_home() {
  local candidate="$1"
  local existing
  for existing in "${codex_homes[@]}"; do
    if [ "$existing" = "$candidate" ]; then
      return
    fi
  done
  codex_homes+=("$candidate")
}

if [ -d "$HOME/.codex-app" ]; then
  append_codex_home "$HOME/.codex-app"
fi
if [ -n "${CODEX_HOME:-}" ]; then
  append_codex_home "$CODEX_HOME"
fi

merge_config() {
  python3 - "$managed_config" "$1" "$2" "${3:-}" <<'PY'
from __future__ import annotations

import json
import re
import sys
import tomllib
from datetime import date, datetime, time
from pathlib import Path
from typing import Any

managed_path = Path(sys.argv[1])
codex_path = Path(sys.argv[2])
tmp_path = Path(sys.argv[3])


def load_toml(path: Path, *, missing_ok: bool = False) -> dict[str, Any]:
    if missing_ok and not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


try:
    managed = load_toml(managed_path)
    existing = load_toml(codex_path, missing_ok=True)
except tomllib.TOMLDecodeError as e:
    print(f"ERROR: invalid TOML: {e}", file=sys.stderr)
    sys.exit(1)


RETIRED_MANAGED_FILESYSTEM_PATHS: dict[str, tuple[str, ...]] = {
    "dotfiles-secure": (
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gcloud/**",
    ),
}


def strip_stale_managed_filesystem_rules(
    existing: dict[str, Any], managed: dict[str, Any]
) -> None:
    existing_perms = existing.get("permissions")
    managed_perms = managed.get("permissions")
    if not isinstance(existing_perms, dict) or not isinstance(managed_perms, dict):
        return
    for name, profile in existing_perms.items():
        # Only clean profiles the dotfiles own. User-defined profiles may carry
        # legitimate path-scoped rules; never touch them.
        if name not in managed_perms or not isinstance(profile, dict):
            continue
        filesystem = profile.get("filesystem")
        if not isinstance(filesystem, dict):
            continue
        for path in RETIRED_MANAGED_FILESYSTEM_PATHS.get(name, ()):
            filesystem.pop(path, None)
        managed_profile = managed_perms.get(name)
        managed_filesystem = (
            managed_profile.get("filesystem")
            if isinstance(managed_profile, dict)
            else None
        )
        managed_workspace_roots = (
            managed_filesystem.get(":workspace_roots")
            if isinstance(managed_filesystem, dict)
            else None
        )
        managed_root_mode = (
            managed_workspace_roots.get(".")
            if isinstance(managed_workspace_roots, dict)
            else None
        )
        workspace_roots = filesystem.get(":workspace_roots")
        # Retire the pre-#200 dotenv glob without removing custom profile rules.
        if (
            name == "dotfiles-secure"
            and isinstance(workspace_roots, dict)
            and isinstance(managed_workspace_roots, dict)
            and "**/.env*" not in managed_workspace_roots
            and workspace_roots.get("**/.env*") == "deny"
        ):
            del workspace_roots["**/.env*"]
        if (
            isinstance(workspace_roots, dict)
            and isinstance(managed_workspace_roots, dict)
            and ".env" in managed_workspace_roots
            and "**/.env" not in managed_workspace_roots
        ):
            workspace_roots.pop("**/.env", None)
        if isinstance(workspace_roots, dict) and workspace_roots.get(".git") == "write":
            del workspace_roots[".git"]
        for key, value in list(filesystem.items()):
            # Codex-expanded workspace maps use an absolute concrete root and
            # retain the managed "." mode. Independent nested rules do not.
            if (
                isinstance(value, dict)
                and key.startswith("/")
                and managed_root_mode is not None
                and key not in managed_filesystem
                and value.get(".") == managed_root_mode
            ):
                del filesystem[key]
            elif (
                value == "write"
                and key.startswith("/")
                and key.rstrip("/").endswith("/.git")
            ):
                del filesystem[key]


def strip_retired_plugins(existing: dict[str, Any]) -> None:
    plugins = existing.get("plugins")
    if not isinstance(plugins, dict):
        return
    for name in ("superpowers@openai-curated",):
        plugins.pop(name, None)
    if not plugins:
        existing.pop("plugins", None)


def strip_retired_sandbox_settings(existing: dict[str, Any], managed: dict[str, Any]) -> None:
    if "default_permissions" not in managed:
        return
    existing.pop("sandbox_mode", None)
    existing.pop("sandbox_workspace_write", None)


def strip_managed_network_domains(existing: dict[str, Any], managed: dict[str, Any]) -> None:
    existing_perms = existing.get("permissions")
    managed_perms = managed.get("permissions")
    if not isinstance(existing_perms, dict) or not isinstance(managed_perms, dict):
        return
    for name, managed_profile in managed_perms.items():
        if not isinstance(managed_profile, dict):
            continue
        managed_network = managed_profile.get("network")
        if not isinstance(managed_network, dict) or "domains" not in managed_network:
            continue
        existing_profile = existing_perms.get(name)
        if not isinstance(existing_profile, dict):
            continue
        existing_network = existing_profile.get("network")
        if isinstance(existing_network, dict):
            existing_network.pop("domains", None)


strip_stale_managed_filesystem_rules(existing, managed)
strip_retired_plugins(existing)
strip_retired_sandbox_settings(existing, managed)
strip_managed_network_domains(existing, managed)


SKILLS_PLUGIN_CACHE = Path("plugins/cache/treflebonbon/treflebonbon-skills")


def verified_skills_plugin_cache(
    codex_path: Path, verification: dict[str, Any] | None
) -> Path | None:
    if verification is None:
        return None
    pin = verification.get("pin")
    version = pin.get("version") if isinstance(pin, dict) else None
    if (
        verification.get("status") != "verified"
        or not isinstance(version, str)
        or not version
        or version in {".", ".."}
        or Path(version).name != version
        or "/" in version
        or "\\" in version
    ):
        raise ValueError("skills plugin verification result is invalid")

    home = codex_path.parent.resolve()
    homes = verification.get("codex_homes")
    if not isinstance(homes, list) or homes.count(str(home)) != 1:
        raise ValueError(f"skills plugin verification omits Codex home {home}")
    results = verification.get("results")
    records = results.get("codex") if isinstance(results, dict) else None
    matches = (
        [
            record
            for record in records
            if isinstance(record, dict)
            and record.get("runtime") == "codex"
            and record.get("codex_home") == str(home)
        ]
        if isinstance(records, list)
        else []
    )
    if len(matches) != 1:
        raise ValueError(f"skills plugin verification is ambiguous for {home}")

    expected = home / SKILLS_PLUGIN_CACHE / version
    result = matches[0]
    if (
        result.get("version") != version
        or result.get("install_path") != str(expected)
        or expected.is_symlink()
        or not expected.is_dir()
    ):
        raise ValueError(f"skills plugin cache is not verified for {home}")
    return expected


def remove_managed_skills_plugin_cache_rules(
    existing: dict[str, Any], managed: dict[str, Any], codex_path: Path
) -> None:
    existing_permissions = existing.get("permissions")
    managed_permissions = managed.get("permissions")
    if not isinstance(existing_permissions, dict) or not isinstance(
        managed_permissions, dict
    ):
        return
    cache_root = codex_path.parent.resolve() / SKILLS_PLUGIN_CACHE
    for profile_name in ("dotfiles-secure", "dotfiles-peer"):
        if profile_name not in managed_permissions:
            continue
        profile = existing_permissions.get(profile_name)
        filesystem = profile.get("filesystem") if isinstance(profile, dict) else None
        if not isinstance(filesystem, dict):
            continue
        for key in list(filesystem):
            path = Path(key) if isinstance(key, str) else None
            if path == cache_root or (path is not None and path.parent == cache_root):
                del filesystem[key]


def add_verified_skills_plugin_cache_read(
    managed: dict[str, Any], codex_path: Path, verification: dict[str, Any] | None
) -> None:
    install_path = verified_skills_plugin_cache(codex_path, verification)
    if install_path is None:
        return
    permissions = managed.get("permissions")
    if not isinstance(permissions, dict):
        return
    secure_profile = permissions.get("dotfiles-secure")
    secure_filesystem = (
        secure_profile.get("filesystem")
        if isinstance(secure_profile, dict)
        else None
    )
    workspace_rules = (
        secure_filesystem.get(":workspace_roots")
        if isinstance(secure_filesystem, dict)
        else None
    )
    denied_names = {
        ("**/.env" if pattern == ".env" else pattern): mode
        for pattern, mode in workspace_rules.items()
        if mode == "deny"
    } if isinstance(workspace_rules, dict) else {}
    for profile_name in ("dotfiles-secure", "dotfiles-peer"):
        profile = permissions.get(profile_name)
        if not isinstance(profile, dict):
            continue
        filesystem = profile.setdefault("filesystem", {})
        if not isinstance(filesystem, dict):
            continue
        filesystem[str(install_path)] = {".": "read", **denied_names}


try:
    verification = json.loads(sys.argv[4]) if sys.argv[4] else None
    if verification is not None and not isinstance(verification, dict):
        raise ValueError("skills plugin verification result is invalid")
    remove_managed_skills_plugin_cache_rules(existing, managed, codex_path)
    add_verified_skills_plugin_cache_read(managed, codex_path, verification)
except (json.JSONDecodeError, ValueError) as error:
    print(f"ERROR: {error}", file=sys.stderr)
    sys.exit(1)

for key in ("projects", "notice", "tui"):
    if key in managed:
        print(f"ERROR: managed Codex config must not contain [{key}]", file=sys.stderr)
        sys.exit(1)


def deep_merge(base: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
    merged = dict(base)
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def format_key(key: str) -> str:
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*", key):
        return key
    return json.dumps(key, ensure_ascii=False)


def format_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, (datetime, date, time)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(format_value(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(
            f"{format_key(key)} = {format_value(item)}" for key, item in value.items()
        ) + "}"
    raise TypeError(f"unsupported TOML value type: {type(value).__name__}")


def emit_table(path: list[str], table: dict[str, Any], lines: list[str]) -> None:
    scalars = [
        (key, value)
        for key, value in table.items()
        if not isinstance(value, dict)
    ]
    children = [
        (key, value)
        for key, value in table.items()
        if isinstance(value, dict)
    ]

    if path and scalars:
        if lines and lines[-1] != "":
            lines.append("")
        lines.append("[" + ".".join(format_key(part) for part in path) + "]")
        for key, value in scalars:
            lines.append(f"{format_key(key)} = {format_value(value)}")

    for key, value in children:
        emit_table([*path, key], value, lines)


result = deep_merge(existing, managed)
if isinstance(result.get("features"), dict):
    result["features"].pop("codex_hooks", None)
lines: list[str] = []

for key, value in result.items():
    if not isinstance(value, dict):
        lines.append(f"{format_key(key)} = {format_value(value)}")

for key, value in result.items():
    if isinstance(value, dict):
        emit_table([key], value, lines)

tmp_path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
PY
}

prepare_file() {
  local source="$1"
  target="$2"
  if [ -d "$target" ]; then
    echo "ERROR: Codex managed target is a directory: $target" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$target")"
  local staged
  staged="$(mktemp "$target.tmp.XXXXXX")"
  staged_files+=("$staged")
  targets+=("$target")
  if [ "$source" = "$managed_config" ]; then
    merge_config "$target" "$staged"
  else
    cp "$source" "$staged"
  fi
  chmod 600 "$staged"
}

plugin_sync_args=()
for codex_home in "${codex_homes[@]}"; do
  plugin_sync_args+=(--codex-home "$codex_home")
done

verify_managed_cache_permissions() {
  local verification
  verification="$(sync-skills-plugin --verify-only "${plugin_sync_args[@]}")"
  python3 - "$managed_config" "$verification" "${codex_homes[@]}" <<'PY'
from __future__ import annotations

import json
import sys
import tomllib
from pathlib import Path

managed_config = Path(sys.argv[1])
verification = json.loads(sys.argv[2])
requested_homes = [Path(path).expanduser().resolve(strict=True) for path in sys.argv[3:]]
if not isinstance(verification, dict) or verification.get("status") != "verified":
    raise SystemExit("ERROR: skills plugin installation is not verified")
home_names = [str(home) for home in requested_homes]
if verification.get("codex_homes") != home_names:
    raise SystemExit("ERROR: verified Codex homes do not match managed homes")
pin = verification.get("pin")
version = pin.get("version") if isinstance(pin, dict) else None
if not isinstance(version, str) or not version or Path(version).name != version:
    raise SystemExit("ERROR: verified skills plugin version is invalid")
results = verification.get("results")
records = results.get("codex") if isinstance(results, dict) else None
if not isinstance(records, list):
    raise SystemExit("ERROR: verified Codex plugin results are invalid")
record_homes = [record.get("codex_home") for record in records if isinstance(record, dict)]
if record_homes != home_names:
    raise SystemExit("ERROR: verified Codex plugin results do not match managed homes")
managed = tomllib.loads(managed_config.read_text(encoding="utf-8"))
managed_profiles = managed.get("permissions")
if not isinstance(managed_profiles, dict):
    raise SystemExit("ERROR: managed Codex permission profiles are invalid")
relative_cache = Path("plugins/cache/treflebonbon/treflebonbon-skills")
verified = []
for home, record in zip(requested_homes, records, strict=True):
    install = home / relative_cache / version
    if (
        record.get("runtime") != "codex"
        or record.get("version") != version
        or record.get("install_path") != str(install)
        or install.is_symlink()
        or not install.is_dir()
    ):
        raise SystemExit(f"ERROR: verified skills plugin cache path is invalid for {home}")
    try:
        config = tomllib.loads((home / "config.toml").read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise SystemExit(f"ERROR: managed Codex config is unreadable for {home}") from error
    permissions = config.get("permissions")
    if not isinstance(permissions, dict):
        raise SystemExit(f"ERROR: managed Codex permissions are missing for {home}")
    cache_root = home / relative_cache
    broad_roots = {
        home / "plugins",
        home / "plugins/cache",
        home / "plugins/cache/treflebonbon",
        cache_root,
    }
    profile_names = ("dotfiles-secure", "dotfiles-peer")
    profile_results = []
    for profile_name in profile_names:
        managed_profile = managed_profiles.get(profile_name)
        profile = permissions.get(profile_name)
        filesystem = profile.get("filesystem") if isinstance(profile, dict) else None
        managed_filesystem = (
            managed_profile.get("filesystem")
            if isinstance(managed_profile, dict)
            else None
        )
        rule = filesystem.get(str(install)) if isinstance(filesystem, dict) else None
        if not isinstance(rule, dict) or rule.get(".") != "read":
            raise SystemExit(
                f"ERROR: exact verified plugin cache read grant is missing for {profile_name} at {home}"
            )
        workspace_rules = (
            managed_filesystem.get(":workspace_roots")
            if isinstance(managed_filesystem, dict)
            else None
        )
        denied = sorted(
            {
                "**/.env" if pattern == ".env" else pattern
                for pattern, mode in workspace_rules.items()
                if mode == "deny"
            }
        ) if isinstance(workspace_rules, dict) else []
        if rule != {".": "read", **{pattern: "deny" for pattern in denied}}:
            raise SystemExit(
                f"ERROR: exact plugin cache permissions drifted for {profile_name} at {home}"
            )
        if not isinstance(filesystem, dict):
            raise SystemExit(f"ERROR: filesystem permissions are missing for {profile_name} at {home}")
        for key, value in filesystem.items():
            if (
                not isinstance(key, str)
                or not isinstance(value, dict)
                or value.get(".") not in {"read", "write"}
            ):
                continue
            path = Path(key)
            if path in broad_roots or (
                path.is_relative_to(cache_root) and path != install
            ) or (str(key).startswith(str(home / "plugins/cache") + "/") and "*" in key):
                raise SystemExit(f"ERROR: broad skills plugin cache grant found for {profile_name} at {home}")
        profile_results.append({"profile": profile_name, "install_path": str(install), "denied_globs": denied})
    verified.append({"codex_home": str(home), "install_path": str(install), "profiles": profile_results})
print(json.dumps({"status": "verified", "pin": pin, "codex_homes": home_names, "results": {"codex": verified}}, sort_keys=True))
PY
}

if [ "$verify_only" -eq 1 ]; then
  phase="skills plugin profile verification"
  target="exact cache read permissions"
  verify_managed_cache_permissions
  exit 0
fi

for codex_home in "${codex_homes[@]}"; do
  for relative_path in "${managed_files[@]}"; do
    prepare_file "$managed_root/$relative_path" "$codex_home/$relative_path"
  done
  if [ "$codex_home" = "$HOME/.codex-app" ]; then
    prepare_file /dev/null "$codex_home/.managed-config-seeded"
  fi
done

phase="skills-plugin"
target="treflebonbon-skills"
sync-skills-plugin "${plugin_sync_args[@]}"
phase="skills-plugin verification"
target="verified Codex plugin payload"
verified_plugin_state="$(sync-skills-plugin --verify-only "${plugin_sync_args[@]}")"

refresh_config_stage() {
  local codex_home="$1"
  local config_target="$codex_home/config.toml"
  local target_index="" index previous_stage replacement_index replacement_stage
  for index in "${!targets[@]}"; do
    if [ "${targets[$index]}" = "$config_target" ]; then
      target_index="$index"
      break
    fi
  done
  if [ -z "$target_index" ]; then
    echo "ERROR: Codex config stage not found: $config_target" >&2
    return 1
  fi

  replacement_stage="$(mktemp "$config_target.tmp.XXXXXX")"
  staged_files+=("$replacement_stage")
  replacement_index=$((${#staged_files[@]} - 1))
  merge_config "$config_target" "$replacement_stage" "$verified_plugin_state"
  chmod 600 "$replacement_stage"

  previous_stage="${staged_files[$target_index]}"
  staged_files[target_index]="$replacement_stage"
  staged_files[replacement_index]="$previous_stage"
  rm -f -- "$previous_stage"
}

phase="refresh"
target="Codex plugin-managed config"
for codex_home in "${codex_homes[@]}"; do
  refresh_config_stage "$codex_home"
done

phase="apply"
for index in "${!targets[@]}"; do
  target="${targets[$index]}"
  mv -- "${staged_files[$index]}" "$target"
done

sync_ponytail_plugin() {
  local codex_home="$1"
  # An explicitly empty PONYTAIL_MARKETPLACE_SOURCE (as opposed to unset)
  # skips this step entirely: some callers exercise sync-codex-managed-config
  # purely for its file-merge behavior and must not have this step's `codex`
  # calls (which persist marketplace state back into config.toml) disturb it.
  local marketplace_source="${PONYTAIL_MARKETPLACE_SOURCE-dietrichgebert/ponytail}"
  [ -n "$marketplace_source" ] || return 0
  local marketplace_ref="${PONYTAIL_MARKETPLACE_REF-v4.9.0}"
  local marketplace_args=("$marketplace_source")
  if [ -n "$marketplace_ref" ]; then
    marketplace_args+=(--ref "$marketplace_ref")
  fi
  # `if ! sync_ponytail_plugin` below suspends errexit for this whole function
  # body, so each step must check its own status explicitly or a failed
  # marketplace add would silently fall through to the install call.
  local add_output
  if ! add_output=$(CODEX_HOME="$codex_home" codex plugin marketplace add "${marketplace_args[@]}" 2>&1); then
    # A changed pin (or a stale registration under a different source) makes
    # codex refuse to re-add the same marketplace name; fail-open must not
    # mean "silently keep serving the old pin forever", so recover by
    # re-registering instead of just warning and leaving it as-is.
    case "$add_output" in
    *"already added from a different source"*)
      CODEX_HOME="$codex_home" codex plugin marketplace remove ponytail >/dev/null || return 1
      CODEX_HOME="$codex_home" codex plugin marketplace add "${marketplace_args[@]}" >/dev/null || return 1
      ;;
    *)
      printf '%s\n' "$add_output" >&2
      return 1
      ;;
    esac
  fi
  CODEX_HOME="$codex_home" codex plugin add ponytail@ponytail >/dev/null || return 1
}

# Best-effort: an unreachable marketplace or a codex_home whose config the
# installed codex binary rejects for unrelated reasons (e.g. a deliberately
# minimal migration fixture) must not fail the file sync above.
if command -v codex >/dev/null 2>&1; then
  for codex_home in "${codex_homes[@]}"; do
    if ! sync_ponytail_plugin "$codex_home"; then
      printf 'WARNING: ponytail plugin sync failed for %s\n' "$codex_home" >&2
    fi
  done
fi
