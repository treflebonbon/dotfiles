#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "Usage: sync-codex-managed-config" >&2
  exit 2
fi

managed_root="$HOME/.config/codex"
managed_config="$managed_root/config.toml"
managed_files=(config.toml hooks.json rules/default.rules environments/environment.toml AGENTS.md)
codex_homes=("$HOME/.codex")
staged_files=()
targets=()
phase="prepare"
target="$managed_root"

cleanup() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    printf 'ERROR: Codex managed sync %s failed: %s\n' "$phase" "$target" >&2
  fi
  local staged
  for staged in "${staged_files[@]+"${staged_files[@]}"}"; do
    rm -f -- "$staged"
  done
  return "$status"
}
trap cleanup EXIT

for relative_path in "${managed_files[@]}"; do
  target="$managed_root/$relative_path"
  if [ ! -f "$target" ]; then
    echo "ERROR: Codex managed source not found: $target" >&2
    exit 1
  fi
done

append_codex_home() {
  local candidate="$1"
  local existing
  for existing in "${codex_homes[@]}"; do
    if [ "$existing" = "$candidate" ]; then
      return
    fi
  done
  codex_homes+=("$candidate")
}

if [ -d "$HOME/.codex-app" ]; then
  append_codex_home "$HOME/.codex-app"
fi
if [ -n "${CODEX_HOME:-}" ]; then
  append_codex_home "$CODEX_HOME"
fi

merge_config() {
  python3 - "$managed_config" "$1" "$2" <<'PY'
from __future__ import annotations

import json
import re
import sys
import tomllib
from datetime import date, datetime, time
from pathlib import Path
from typing import Any

managed_path = Path(sys.argv[1])
codex_path = Path(sys.argv[2])
tmp_path = Path(sys.argv[3])


def load_toml(path: Path, *, missing_ok: bool = False) -> dict[str, Any]:
    if missing_ok and not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


try:
    managed = load_toml(managed_path)
    existing = load_toml(codex_path, missing_ok=True)
except tomllib.TOMLDecodeError as e:
    print(f"ERROR: invalid TOML: {e}", file=sys.stderr)
    sys.exit(1)


RETIRED_MANAGED_FILESYSTEM_PATHS: dict[str, tuple[str, ...]] = {
    "dotfiles-secure": (
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gcloud/**",
    ),
}


def strip_stale_managed_filesystem_rules(
    existing: dict[str, Any], managed: dict[str, Any]
) -> None:
    existing_perms = existing.get("permissions")
    managed_perms = managed.get("permissions")
    if not isinstance(existing_perms, dict) or not isinstance(managed_perms, dict):
        return
    for name, profile in existing_perms.items():
        # Only clean profiles the dotfiles own. User-defined profiles may carry
        # legitimate path-scoped rules; never touch them.
        if name not in managed_perms or not isinstance(profile, dict):
            continue
        filesystem = profile.get("filesystem")
        if not isinstance(filesystem, dict):
            continue
        for path in RETIRED_MANAGED_FILESYSTEM_PATHS.get(name, ()):
            filesystem.pop(path, None)
        managed_profile = managed_perms.get(name)
        managed_filesystem = (
            managed_profile.get("filesystem")
            if isinstance(managed_profile, dict)
            else None
        )
        managed_workspace_roots = (
            managed_filesystem.get(":workspace_roots")
            if isinstance(managed_filesystem, dict)
            else None
        )
        managed_root_mode = (
            managed_workspace_roots.get(".")
            if isinstance(managed_workspace_roots, dict)
            else None
        )
        workspace_roots = filesystem.get(":workspace_roots")
        if (
            isinstance(workspace_roots, dict)
            and isinstance(managed_workspace_roots, dict)
            and ".env" in managed_workspace_roots
            and "**/.env" not in managed_workspace_roots
        ):
            workspace_roots.pop("**/.env", None)
        if isinstance(workspace_roots, dict) and workspace_roots.get(".git") == "write":
            del workspace_roots[".git"]
        for key, value in list(filesystem.items()):
            # Codex-expanded workspace maps use an absolute concrete root and
            # retain the managed "." mode. Independent nested rules do not.
            if (
                isinstance(value, dict)
                and key.startswith("/")
                and managed_root_mode is not None
                and value.get(".") == managed_root_mode
            ):
                del filesystem[key]
            elif (
                value == "write"
                and key.startswith("/")
                and key.rstrip("/").endswith("/.git")
            ):
                del filesystem[key]


def strip_retired_plugins(existing: dict[str, Any]) -> None:
    plugins = existing.get("plugins")
    if not isinstance(plugins, dict):
        return
    for name in ("superpowers@openai-curated",):
        plugins.pop(name, None)
    if not plugins:
        existing.pop("plugins", None)


def strip_retired_sandbox_settings(existing: dict[str, Any], managed: dict[str, Any]) -> None:
    if "default_permissions" not in managed:
        return
    existing.pop("sandbox_mode", None)
    existing.pop("sandbox_workspace_write", None)


def strip_managed_network_domains(existing: dict[str, Any], managed: dict[str, Any]) -> None:
    existing_perms = existing.get("permissions")
    managed_perms = managed.get("permissions")
    if not isinstance(existing_perms, dict) or not isinstance(managed_perms, dict):
        return
    for name, managed_profile in managed_perms.items():
        if not isinstance(managed_profile, dict):
            continue
        managed_network = managed_profile.get("network")
        if not isinstance(managed_network, dict) or "domains" not in managed_network:
            continue
        existing_profile = existing_perms.get(name)
        if not isinstance(existing_profile, dict):
            continue
        existing_network = existing_profile.get("network")
        if isinstance(existing_network, dict):
            existing_network.pop("domains", None)


strip_stale_managed_filesystem_rules(existing, managed)
strip_retired_plugins(existing)
strip_retired_sandbox_settings(existing, managed)
strip_managed_network_domains(existing, managed)

for key in ("projects", "notice", "tui"):
    if key in managed:
        print(f"ERROR: managed Codex config must not contain [{key}]", file=sys.stderr)
        sys.exit(1)


def deep_merge(base: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
    merged = dict(base)
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def format_key(key: str) -> str:
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]*", key):
        return key
    return json.dumps(key, ensure_ascii=False)


def format_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, (datetime, date, time)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(format_value(item) for item in value) + "]"
    raise TypeError(f"unsupported TOML value type: {type(value).__name__}")


def emit_table(path: list[str], table: dict[str, Any], lines: list[str]) -> None:
    scalars = [(key, value) for key, value in table.items() if not isinstance(value, dict)]
    children = [(key, value) for key, value in table.items() if isinstance(value, dict)]

    if path and scalars:
        if lines and lines[-1] != "":
            lines.append("")
        lines.append("[" + ".".join(format_key(part) for part in path) + "]")
        for key, value in scalars:
            lines.append(f"{format_key(key)} = {format_value(value)}")

    for key, value in children:
        emit_table([*path, key], value, lines)


result = deep_merge(existing, managed)
if isinstance(result.get("features"), dict):
    result["features"].pop("codex_hooks", None)
lines: list[str] = []

for key, value in result.items():
    if not isinstance(value, dict):
        lines.append(f"{format_key(key)} = {format_value(value)}")

for key, value in result.items():
    if isinstance(value, dict):
        emit_table([key], value, lines)

tmp_path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
PY
}

prepare_file() {
  local source="$1"
  target="$2"
  if [ -d "$target" ]; then
    echo "ERROR: Codex managed target is a directory: $target" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$target")"
  local staged
  staged="$(mktemp "$target.tmp.XXXXXX")"
  staged_files+=("$staged")
  targets+=("$target")
  if [ "$source" = "$managed_config" ]; then
    merge_config "$target" "$staged"
  else
    cp "$source" "$staged"
  fi
  chmod 600 "$staged"
}

for codex_home in "${codex_homes[@]}"; do
  for relative_path in "${managed_files[@]}"; do
    prepare_file "$managed_root/$relative_path" "$codex_home/$relative_path"
  done
  if [ "$codex_home" = "$HOME/.codex-app" ]; then
    prepare_file /dev/null "$codex_home/.managed-config-seeded"
  fi
done

phase="apply"
for index in "${!targets[@]}"; do
  target="${targets[$index]}"
  mv -- "${staged_files[$index]}" "$target"
done
