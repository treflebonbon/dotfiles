{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Bash(*gh pr merge*)",
      "Bash(*gh pr 'merge'*)",
      "Bash(*gh pr \"merge\"*)",
      "Bash(*gh -R * pr merge*)",
      "Bash(*gh --repo * pr merge*)",
      "Bash(*gh --repo=* pr merge*)",
      "Bash(*gh pr -R * merge*)",
      "Bash(*gh pr --repo * merge*)",
      "Bash(*gh pr --repo=* merge*)",
      "Bash(*mergePullRequest*)",
      "Bash(*enablePullRequestAutoMerge*)",
      "Bash(*pulls/*/merge*)",
      "Bash(*gh api*/merges*)"
    ]
  }
}
