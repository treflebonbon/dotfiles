{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1"
  },
  "editorMode": "normal",
  "permissions": {
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": false,
    "additionalDirectories": [
      "~/.claude/jobs",
      "~/runtime",
      "~/.claude/projects",
      "/nix/store",
      "~/ghq/github.com",
      "~/.cache/nix-devshell-tmp"
    ],
    "allow": [
      "Skill",
      "Bash(git-push-topic:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/credentials.json)",
      "Read(**/credentials.*.json)",
      "Read(**/secret.json)",
      "Read(**/secrets.json)",
      "Read(**/service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.gnupg/**)",
      "Edit(**/.env*)",
      "Edit(~/.ssh/**)",
      "Edit(~/runtime/**)",
      "Bash(rm ~:*)",
      "Bash(rm /:*)",
      "Bash(rm -r ~:*)",
      "Bash(rm -r /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(nc:*)",
      "Bash(git push:*)",
      "Bash(/bin/git push:*)",
      "Bash(/usr/bin/git push:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --config-env:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(command git:*)",
      "Bash(env git:*)",
      "Bash(git reset --hard:*)",
      "Bash(gcloud:*)",
      "Bash(aws:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(npm publish:*)",
      "Bash(mix hex.publish:*)"
    ]
  },
  "hooks": {
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/devshell-env\" claude-hook",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/devshell-env\" claude-hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/devshell-env\" claude-hook",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"${IMPECCABLE_BIN:-}\" && test -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" || exit 0; output=\"$(IMPECCABLE_HOOK_QUIET=1 sh \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook 2>/dev/null)\" || exit 0; printf '%s' \"$output\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"${IMPECCABLE_BIN:-}\" && test -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" || exit 0; output=\"$(IMPECCABLE_HOOK_QUIET=1 sh \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook 2>/dev/null)\" || exit 0; printf '%s' \"$output\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "dietrichgebert/ponytail"
      }
    }
  },
  "language": "japanese",
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "model": "sonnet",
  "advisorModel": "opus"
}
