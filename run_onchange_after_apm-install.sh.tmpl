#!/usr/bin/env bash
# apm.yml hash:                {{ include "apm.yml" | sha256sum }}
# apm.lock.yaml hash:          {{ include "apm.lock.yaml" | sha256sum }}
# orphan-cleanup script hash:  {{ includeTemplate "run_onchange_before_remove-orphan-claude-skills.sh.tmpl" . | sha256sum }}
#
# manifest / lockfile / orphan-cleanup の hash が変わった時のみ chezmoi apply
# で再実行される。orphan-cleanup は run_onchange_before_* として APM install の
# 前に走り、APM managed full set と明示した retired skill の cleanup を行う。
# ネットワーク失敗時の retry: chezmoi apply
#
set -euo pipefail

REFRESH_LIB="$HOME/.config/nix-devshell/lib/refresh-cache.sh"
if [ ! -f "$REFRESH_LIB" ]; then
  echo "WARN: nix-devshell cache refresh が見つかりません。APM install を中止します。" >&2
  exit 1
fi
# shellcheck disable=SC1090
. "$REFRESH_LIB"
if ! NIX_DEVSHELL_CACHE_REQUIRED=1 refresh_nix_devshell_cache; then
  echo "WARN: nix-devshell snapshot の refresh に失敗したため、APM install を中止します。" >&2
  exit 1
fi

LIB="$HOME/.config/nix-devshell/lib/ensure-env.sh"
# shellcheck disable=SC1090
[ -f "$LIB" ] && . "$LIB" && ensure_nix_devshell_env

if ! command -v apm >/dev/null 2>&1; then
  echo "WARN: apm CLI が見つかりません。nix-devshell cache 未生成の可能性。" >&2
  echo "      復旧: nix develop \"$HOME/.config/nix-devshell#$(_nix_devshell_selected_output)\" --command chezmoi apply" >&2
  exit 1
fi

cd "$HOME"
# lock 生成・検証時と同じ target / transport を再現する。省略すると
# floating dependency が別条件で再解決され、frozen install が live lock を
# 書き戻して chezmoi source との drift を作る。
apm install --frozen --target claude,codex --https
# 新 lock に旧 owner が無い場合、prune 成功でも旧 skill は残りうる。
# dependency 削除時は runtime/skill-harness.md の旧台帳を使う配備手順に従う。
apm prune
